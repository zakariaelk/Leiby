---
// Layout for the next design direction (/next/). Not indexed while in progress.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/next.css';
import NextHeader from '../components/next/NextHeader.astro';

// base: where the header links point (versions /next/a/ and /next/b/ keep visitors inside them);
// variant: a class on <html> for that version's own styles.
// intro: the home page's opening animation (version A) may play; decided here, before the first paint
// look: a colour or type variation of version A (data-look on <html>); 'dmsans' also loads DM Sans
interface Props { title?: string; description?: string; palette?: 'paper' | 'mono'; base?: string; variant?: string; logo?: boolean; work?: string; intro?: boolean | 'typed'; look?: 'orange' | 'dmsans' }
const { title = 'Zakaria El Khachia · Product designer', description = 'Product designer with a frontend development background.', palette = 'mono', base = '/next/', variant, logo = false, work, intro = false, look } = Astro.props;
---
<!doctype html>
<html lang="en" data-palette={palette} data-look={look} class={variant ? `v-${variant}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/img/favicon/z-logo.png" />
    {look === 'dmsans' && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {look === 'dmsans' && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,500..600&display=swap" />}
    <!-- Theme before first paint: saved choice, else the system setting -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('ze-theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    {intro && (
      <script is:inline data-typed={intro === 'typed' ? '1' : undefined}>
        // Intro: once per visit (?intro replays it; the typed test plays every time), never with reduced
        // motion; released after 6s (14s when the intro types the hero text) whatever happens
        (function () {
          try {
            var typed = !!document.currentScript.dataset.typed;
            var force = typed || /[?&]intro\b/.test(location.search);
            if (!force && sessionStorage.getItem('ze-intro')) return;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            sessionStorage.setItem('ze-intro', '1');
            if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
            var html = document.documentElement;
            html.classList.add('is-intro');
            if (typed) html.classList.add('is-typed');
            setTimeout(function () { html.classList.remove('is-intro', 'is-intro-reveal', 'is-typed', 'is-nav-in'); }, typed ? 14000 : 6000);
          } catch (e) {}
        })();
      </script>
    )}
  </head>
  <body>
    <NextHeader base={base} contact={variant ? '#contact' : undefined} work={work} logo={logo} />
    <main id="main"><slot /></main>
  </body>
</html>
