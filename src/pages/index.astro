---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Edge from '../components/Edge.astro';
import HeroShapes from '../components/HeroShapes.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import home from '../content/pages/home.json';
import { getProjects, getServices, getPosts } from '../lib/data';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const [spotlight, latest] = featured;
const more = projects.filter((p) => p !== spotlight && p !== latest).slice(0, 4);
const services = await getServices();
const posts = (await getPosts()).slice(0, 2);

const [first, ...rest] = home.heroTitle.split(' ');
---
<Base>
  <!-- ========== Intro ========== -->
  <section class="hero bg-sun">
    <div class="container hero__grid">
      <h1 class="hero__title">
        <span class="hero__line">{first}</span>
        <span class="hero__line">{rest.join(' ')}</span>
      </h1>
      <div class="hero__art"><HeroShapes /></div>
      <div class="hero__text">
        <p class="lead">{home.heroText}</p>
        <a href="#how" class="arrow-link">{home.heroLink} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ========== Spotlight project ========== -->
  <section class="spotlight">
    <div class="spotlight__bg" aria-hidden="true"><div class="bg-sun"></div><Edge /></div>
    <div class="container">
      <a href={`/projects/${spotlight.id}/`} class:list={['spotlight__card', `c-${spotlight.data.color}`]}>
        <Image src={spotlight.data.cover} alt="" widths={[640, 1024, 1440, 1920]} sizes="(min-width: 1440px) 1360px, 100vw" loading="eager" fetchpriority="high" />
        <div class="spotlight__label">
          <span class="spotlight__client">{spotlight.data.client}</span>
          <span class="spotlight__title">{spotlight.data.title} <span class="arrow" aria-hidden="true">→</span></span>
        </div>
        <svg class="spotlight__slash" viewBox="0 0 200 400" aria-hidden="true"><path d="M60 0h80L60 400H-20Z" fill="var(--accent)" /></svg>
      </a>
    </div>
  </section>

  <!-- ========== Services ========== -->
  <section class="section services" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title" class="eyebrow" data-reveal>{home.servicesTitle}</h2>
      <ul role="list" class="services__grid">
        {services.map((s, i) => (
          <li data-reveal style={`--delay:${i * 0.06}s`}>
            <a href={`/services/#${s.id}`} class:list={['stile', `c-${s.data.color}`, i === 1 && 'stile--hot']}>
              <ServiceIcon icon={s.data.icon} color={s.data.color} />
              <span class="stile__label">{s.data.short} <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/services/" class="arrow-link services__all">See all services <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ========== Latest case ========== -->
  <section class="section latest" aria-labelledby="latest-title">
    <div class="container latest__grid">
      <div class="latest__text" data-reveal>
        <p class="eyebrow">Latest case:</p>
        <h2 id="latest-title" class="latest__title">
          <a href={`/projects/${latest.id}/`}>{latest.data.intro} <span class="arrow" aria-hidden="true">→</span></a>
        </h2>
        <p class="muted latest__meta">{latest.data.client} · {latest.data.role}</p>
      </div>
      <a href={`/projects/${latest.id}/`} class:list={['latest__media', `c-${latest.data.color}`]} data-reveal style="--delay:.1s" tabindex="-1" aria-hidden="true">
        <Image src={latest.data.cover} alt="" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 60vw, 100vw" />
      </a>
    </div>
  </section>

  <!-- ========== How we work (the story) ========== -->
  <section id="how" class="how bg-ink" aria-labelledby="how-title">
    <div class="container section">
      <h2 id="how-title" class="how__title" data-reveal>{home.processTitle}</h2>
      <ol role="list" class="how__steps">
        {home.process.map((step, i) => (
          <li class="how__step" data-reveal style={`--delay:${i * 0.1}s`}>
            <span class:list={['how__shape', `how__shape--${i}`]} aria-hidden="true"></span>
            <span class="how__num">0{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== CTA + Blog ========== -->
  <section class="section news" aria-label="Get started and latest writing">
    <div class="container news__grid">
      <div class="ctacard" data-reveal>
        <svg class="ctacard__icon" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="46" fill="var(--white)" />
          <circle cx="50" cy="50" r="34" fill="var(--ink)" />
          <circle cx="50" cy="50" r="22" fill="var(--white)" />
          <circle cx="50" cy="50" r="10" fill="var(--ink)" />
          <path class="ctacard__dart" d="M50 50 92 8" stroke="var(--coral)" stroke-width="8" stroke-linecap="round" />
        </svg>
        <h2>{home.ctaTitle}</h2>
        <p>{home.ctaText}</p>
        <a href="/contact/" class="btn">{home.ctaButton} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      {posts.map((post, i) => <PostCard post={post} delay={(i + 1) * 0.08} />)}
    </div>
  </section>

  <!-- ========== More projects ========== -->
  <section class="section more" aria-labelledby="more-title">
    <div class="container">
      <div class="more__head">
        <h2 id="more-title" class="eyebrow">More projects</h2>
        <a href="/projects/" class="arrow-link">All projects <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="more__grid">
        {more.map((p, i) => <ProjectCard project={p} delay={(i % 2) * 0.08} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3rem); }
  .hero__grid {
    display: grid; gap: 1.5rem 2rem;
    grid-template-columns: 1fr;
    grid-template-areas: 'title' 'text' 'art';
  }
  .hero__title {
    grid-area: title;
    font-size: var(--fs-display); line-height: 0.92; letter-spacing: -0.055em; font-weight: 720;
  }
  .hero__line { display: block; animation: rise 0.9s var(--ease-out) both; }
  .hero__line + .hero__line { animation-delay: 0.12s; color: var(--white); -webkit-text-stroke: 0; }
  @keyframes rise { from { opacity: 0; transform: translateY(0.4em); } to { opacity: 1; transform: none; } }
  .hero__art { grid-area: art; max-width: min(320px, 80vw); width: 100%; justify-self: center; margin-block: -0.5rem -1rem; }
  .hero__text { grid-area: text; display: grid; gap: 1.25rem; justify-items: start; max-width: 38ch; animation: rise 0.9s var(--ease-out) 0.25s both; }

  @media (min-width: 768px) {
    .hero__grid {
      grid-template-columns: 1.15fr 1fr;
      grid-template-areas: 'title art' 'text art';
      align-items: end;
    }
    .hero__art { max-width: none; align-self: center; margin: 0; }
  }
  @media (min-width: 1100px) {
    .hero__grid { grid-template-columns: 1.3fr 1fr; }
  }

  /* ---------- Spotlight ---------- */
  .spotlight { position: relative; }
  .spotlight__bg { position: absolute; inset: -1px 0 auto; height: 55%; display: grid; grid-template-rows: 1fr auto; }
  .spotlight__bg .bg-sun { height: 100%; }
  .spotlight__bg :global(.edge) { color: var(--paper); }
  .spotlight .container { position: relative; }
  .spotlight__card {
    position: relative; display: block; overflow: hidden; border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3; background: var(--ink); text-decoration: none; color: var(--white);
  }
  @media (min-width: 768px) { .spotlight__card { aspect-ratio: 16 / 8; } }
  .spotlight__card :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .spotlight__card:hover :global(img) { transform: scale(1.03); }
  .spotlight__label {
    position: absolute; left: clamp(1rem, 3vw, 2.25rem); top: clamp(1rem, 3vw, 2.25rem);
    display: grid; gap: 0.2rem; max-width: min(90%, 30ch);
    background: var(--ink); padding: 1rem 1.25rem; border-radius: var(--radius);
  }
  .spotlight__client { font-size: var(--fs-small); font-weight: var(--fw-bold); color: var(--sun); text-transform: uppercase; letter-spacing: 0.08em; }
  .spotlight__title { font-size: var(--fs-h3); font-weight: var(--fw-bold); letter-spacing: -0.025em; line-height: 1.1; }
  .spotlight__slash {
    position: absolute; right: 8%; top: 0; height: 100%; width: auto; opacity: 0.9; mix-blend-mode: multiply;
    transform: translateX(40%); transition: transform 0.9s var(--ease-out);
  }
  .spotlight__card:hover .spotlight__slash { transform: translateX(10%); }

  /* ---------- Services ---------- */
  .services__grid {
    display: grid; gap: clamp(0.75rem, 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) { .services__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .services__grid { grid-template-columns: repeat(3, 1fr); } }
  .stile {
    display: flex; align-items: center; gap: 1.1rem; height: 100%;
    padding: 1.35rem 1.5rem; min-height: 96px;
    background: var(--white); border-radius: var(--radius);
    text-decoration: none; font-weight: var(--fw-bold); font-size: 1.12rem; letter-spacing: -0.01em;
    box-shadow: 0 0 0 0 var(--ink);
    transition: transform 0.35s var(--ease-bounce), box-shadow 0.35s var(--ease-out), background 0.3s;
  }
  .stile:hover { transform: translate(-4px, -4px); box-shadow: 6px 6px 0 0 var(--ink); }
  .stile--hot { background: var(--coral); color: var(--white); }
  .stile--hot :global(.sicon) { --accent: var(--sun); }
  .stile--hot :global(.sicon [fill='var(--ink)']) { fill: var(--white); }
  .stile__label { display: inline-flex; gap: 0.4em; align-items: center; }
  .services__all { margin-top: 2rem; color: var(--coral); }

  /* ---------- Latest case ---------- */
  .latest { padding-top: 0; }
  .latest__grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .latest__grid { grid-template-columns: 1fr 1.6fr; gap: clamp(2rem, 5vw, 5rem); } }
  .latest__title { font-size: var(--fs-h3); line-height: 1.2; }
  .latest__title a { text-decoration: none; }
  .latest__title a:hover { color: var(--coral); }
  .latest__meta { margin-top: 1rem; font-weight: var(--fw-medium); }
  .latest__media { display: block; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 16 / 10; background: var(--accent); }
  .latest__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .latest__media:hover :global(img) { transform: scale(1.03); }

  /* ---------- How we work ---------- */
  .how__title { font-size: var(--fs-h1); max-width: 14ch; color: var(--sun); }
  .how__steps { display: grid; gap: 1.5rem; margin-top: clamp(2.5rem, 5vw, 4.5rem); padding: 0; }
  @media (min-width: 768px) { .how__steps { grid-template-columns: repeat(3, 1fr); } }
  .how__step {
    position: relative; padding: clamp(1.5rem, 2.5vw, 2.25rem); border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12);
    display: grid; gap: 0.75rem; align-content: start; overflow: hidden;
  }
  .how__step h3 { font-size: var(--fs-h3); }
  .how__step p { color: rgba(255, 255, 255, 0.78); }
  .how__num { font-weight: var(--fw-bold); color: var(--sun); font-size: var(--fs-small); letter-spacing: 0.1em; }
  .how__shape { width: 64px; height: 64px; margin-bottom: 0.75rem; transition: transform 0.6s var(--ease-bounce); }
  .how__step:hover .how__shape { transform: rotate(-20deg) scale(1.1); }
  .how__shape--0 { background: var(--coral); border-radius: 50%; animation: float 4s ease-in-out infinite; }
  .how__shape--1 { background: var(--blue); border-radius: 50% 50% 0 0; height: 32px; margin-top: 32px; animation: wobble 3.2s ease-in-out infinite; transform-origin: bottom; }
  .how__shape--2 { background: var(--mint); clip-path: polygon(50% 0, 100% 100%, 0 100%); animation: drift 5s ease-in-out infinite; }

  /* ---------- CTA + Blog ---------- */
  .news__grid { display: grid; gap: clamp(2rem, 3vw, 2.5rem); }
  @media (min-width: 700px) { .news__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .news__grid { grid-template-columns: 1.05fr 1fr 1fr; } }
  .ctacard {
    background: var(--coral); color: var(--white); border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 3vw, 2.5rem); display: grid; gap: 1rem; align-content: start; justify-items: start;
  }
  @media (min-width: 700px) and (max-width: 1099px) { .ctacard { grid-column: 1 / -1; } }
  .ctacard__icon { width: 96px; margin-bottom: 1rem; overflow: visible; }
  .ctacard__dart { stroke-dasharray: 60; stroke-dashoffset: 60; }
  .ctacard.is-in .ctacard__dart { animation: draw 0.6s var(--ease-out) 0.5s forwards; }
  .ctacard h2 { font-size: var(--fs-h2); }
  .ctacard p { font-size: var(--fs-lead); line-height: 1.4; font-weight: var(--fw-medium); max-width: 26ch; }
  .ctacard .btn { margin-top: 0.75rem; }
  .ctacard .btn:hover { box-shadow: 4px 4px 0 0 var(--sun); }

  /* ---------- More projects ---------- */
  .more { padding-top: 0; }
  .more__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .more__grid { display: grid; gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  @media (min-width: 700px) { .more__grid { grid-template-columns: repeat(2, 1fr); } }
</style>
