---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import home from '../content/pages/home.json';
import { getServices } from '../lib/data';

const services = await getServices();
---
<Base title="Services" description="Product & UX design, websites, mobile apps, data dashboards, design systems and usability testing.">
  <PageHero
    eyebrow="Services"
    title="Design and build, from question to launch."
    intro="Pick one thing or the whole journey. Either way, I work inside your problem with you, not next to it."
    shape="triangle"
  />

  <section class="section">
    <div class="container">
      <ul role="list" class="svc-list">
        {services.map((s, i) => (
          <li id={s.id} class:list={['svc', `c-${s.data.color}`]} data-reveal>
            <div class="svc__head">
              <span class="svc__num">0{i + 1}</span>
              <ServiceIcon icon={s.data.icon} color={s.data.color} />
            </div>
            <div class="svc__main">
              <h2>{s.data.title}</h2>
              <p class="lead">{s.data.summary}</p>
            </div>
            <ul role="list" class="svc__list">
              {s.data.deliverables.map((d) => <li>{d}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section how-strip bg-ink">
    <div class="container how-strip__grid">
      <h2>{home.processTitle}</h2>
      <ol role="list">
        {home.process.map((p, i) => (
          <li data-reveal style={`--delay:${i * 0.08}s`}><strong>{p.title}</strong> {p.text}</li>
        ))}
      </ol>
      <a href="/contact/" class="btn btn--sun">Start a project <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .section:first-of-type { padding-top: clamp(2rem, 4vw, 3.5rem); }
  .svc-list { display: grid; gap: clamp(1rem, 2vw, 1.5rem); }
  .svc {
    display: grid; gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2.75rem);
    background: var(--white); border-radius: var(--radius-lg);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
    position: relative; overflow: hidden;
  }
  .svc::after {
    content: ''; position: absolute; right: -60px; top: -60px; width: 160px; height: 160px; border-radius: 50%;
    background: var(--accent); opacity: 0.15; transition: transform 0.8s var(--ease-bounce);
  }
  .svc:hover::after { transform: scale(1.6); }
  .svc:target { box-shadow: 0 0 0 4px var(--accent); }
  .svc__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .svc__num { font-weight: var(--fw-bold); color: var(--coral); letter-spacing: 0.08em; }
  .svc__main h2 { font-size: var(--fs-h2); letter-spacing: -0.035em; }
  .svc__main .lead { margin-top: 0.75rem; max-width: 36ch; color: var(--ink-soft); }
  .svc__list { display: grid; gap: 0.5rem; align-content: start; position: relative; z-index: 1; }
  .svc__list li { display: flex; gap: 0.7rem; align-items: baseline; font-weight: var(--fw-medium); }
  .svc__list li::before { content: ''; flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); transform: translateY(-1px); }
  @media (min-width: 900px) {
    .svc { grid-template-columns: 120px 1.4fr 1fr; align-items: start; gap: 2.5rem; }
    .svc__head { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  }

  .how-strip__grid { display: grid; gap: 2rem; }
  .how-strip h2 { font-size: var(--fs-h2); color: var(--sun); max-width: 14ch; }
  .how-strip ol { display: grid; gap: 1.25rem; padding: 0; }
  .how-strip li { font-size: var(--fs-lead); line-height: 1.4; color: rgba(255, 255, 255, 0.8); max-width: 44ch; }
  .how-strip strong { color: var(--white); font-weight: var(--fw-bold); display: block; }
  .how-strip .btn { justify-self: start; }
  @media (min-width: 900px) {
    .how-strip__grid { grid-template-columns: 1fr 1.2fr; align-items: start; }
    .how-strip .btn { grid-column: 2; }
  }
</style>
