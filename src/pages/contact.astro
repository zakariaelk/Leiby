---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import settings from '../content/pages/settings.json';

const steps = [
  { title: 'You write', text: 'A few lines about the problem, the deadline and who it is for. Messy is fine.' },
  { title: 'We talk', text: 'A free 30-minute call to understand the problem and see if we are a good fit.' },
  { title: 'You get a plan', text: 'A short proposal with a clear first step, timeline and price.' },
];
---
<Base title="Contact" description="Start a project with Leiby Design & Build.">
  <PageHero eyebrow="Contact" title="Let's walk it together." intro="Tell me about the problem you're trying to solve. I reply within two working days." shape="dome">
    <div class="contact-cta">
      <a class="contact-email" href={`mailto:${settings.email}`}>{settings.email}</a>
      <a class="btn" href={settings.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arrow arrow--up" aria-hidden="true">→</span></a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <h2 class="eyebrow">What happens next</h2>
      <ol role="list" class="steps">
        {steps.map((s, i) => (
          <li data-reveal style={`--delay:${i * 0.08}s`}>
            <span class="steps__num">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .contact-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }
  .contact-email {
    font-size: clamp(1.4rem, 1rem + 2vw, 2.5rem); font-weight: var(--fw-bold); letter-spacing: -0.03em;
    text-decoration-color: var(--coral); text-decoration-thickness: 4px; text-underline-offset: 8px; word-break: break-word;
  }
  .contact-email:hover { color: var(--coral); }
  .section { padding-top: clamp(2rem, 4vw, 3.5rem); }
  .steps { display: grid; gap: 1.25rem; padding: 0; }
  @media (min-width: 768px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .steps li { background: var(--white); border-radius: var(--radius-lg); padding: clamp(1.5rem, 3vw, 2.25rem); display: grid; gap: 0.6rem; align-content: start; }
  .steps__num { color: var(--coral); font-weight: var(--fw-bold); letter-spacing: 0.08em; }
  .steps h3 { font-size: var(--fs-h3); }
  .steps p { color: var(--ink-soft); }
</style>
