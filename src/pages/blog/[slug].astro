---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getPosts, formatDate } from '../../lib/data';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, summary, date, tag } = post.data;
---
<Base title={title} description={summary}>
  <PageHero eyebrow={tag} title={title} intro={summary}>
    <p class="date"><time datetime={date.toISOString()}>{formatDate(date)}</time></p>
  </PageHero>
  <section class="section">
    <div class="container">
      <article class="prose"><Content /></article>
      <a href="/blog/" class="arrow-link back"><span class="arrow" aria-hidden="true">←</span> All posts</a>
    </div>
  </section>
</Base>

<style>
  .section { padding-top: clamp(2rem, 4vw, 3.5rem); }
  .date { margin-top: 1.25rem; font-weight: var(--fw-bold); font-size: var(--fs-small); }
  .back { margin-top: 3rem; }
  .back:hover .arrow { transform: translateX(-5px); }
</style>
