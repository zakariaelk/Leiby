---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/data';

const posts = await getPosts();
---
<Base title="Blog" description="Notes on design, building and working together on hard problems.">
  <PageHero eyebrow="Blog" title="Notes from the work." intro="Short pieces on process, building and the lessons that come out of real projects." />
  <section class="section">
    <div class="container grid">
      {posts.map((post, i) => <PostCard post={post} delay={(i % 3) * 0.08} />)}
    </div>
  </section>
</Base>

<style>
  .section { padding-top: clamp(2rem, 4vw, 3.5rem); }
  .grid { display: grid; gap: 3rem 2rem; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
