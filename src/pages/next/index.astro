---
// Next design direction: home. Intro, featured work (three projects, text left and visual
// right), then the rest as a simple list. About and contact come next.
import { Image, getImage } from 'astro:assets';
import Next from '../../layouts/Next.astro';
import { getProjects } from '../../lib/data';
import { posterFor } from '../../lib/media';

const FEATURED = ['mitigating-risk-with-location-based-alerts', '3e-international', 'ngosafety-website-redesign'];
const projects = await getProjects();
const featured = await Promise.all(FEATURED.map(async (id) => {
  const p = projects.find((x) => x.id === id)!;
  const video = p.data.featuredVideo;
  const poster = video ? posterFor(video) : undefined;
  const posterSrc = poster ? (await getImage({ src: poster, format: 'webp', width: 1280 })).src : undefined;
  return { p, video, poster, posterSrc };
}));
const rest = projects.filter((p) => !FEATURED.includes(p.id));
---
<Next>
  <section class="n-intro">
    <h1>Product designer, creative builder.</h1>
    <p>12+ years designing and building web and mobile interfaces. Most recently at INSO, I designed and shipped safety tools for humanitarian workers in conflict zones.</p>
  </section>

  <section class="n-featured" id="work" aria-labelledby="featured-label">
    <p class="n-label" id="featured-label">Featured work</p>
    {featured.map(({ p, video, poster, posterSrc }) => (
      <article class="n-card">
        <div class="n-card__text">
          <p class="n-card__client"><span>{p.data.client}</span>{p.data.tagline && ` · ${p.data.tagline}`}</p>
          <h2 class="n-card__title"><a href={`/work/${p.id}/`}>{p.data.statement ?? p.data.headline}</a></h2>
          <dl class="n-card__meta">
            {[
              { label: 'Project type', value: p.data.projectType },
              { label: 'Role', value: p.data.role },
              { label: 'Industry', value: p.data.sector },
            ].filter((m) => m.value).map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}
          </dl>
          <a class="n-card__cta" href={`/work/${p.id}/`} aria-hidden="true" tabindex="-1">Read the case study</a>
        </div>
        <div class="n-card__visual">
          {video ? (
            <video class="n-video" src={video} poster={posterSrc} width={poster?.width} height={poster?.height} muted loop playsinline preload="none" aria-label={`${p.data.client}: ${p.data.tagline ?? ''}`}></video>
          ) : (
            <Image src={p.data.cover} alt={`${p.data.client}: ${p.data.tagline ?? p.data.title}`} widths={[640, 960, 1280, 1600]} sizes="(min-width: 900px) 55vw, 100vw" />
          )}
        </div>
      </article>
    ))}
  </section>

  <section class="n-list" aria-labelledby="more-label">
    <p class="n-label" id="more-label">Selected work</p>
    <ul>
      {rest.map((p) => (
        <li>
          <a href={`/work/${p.id}/`}>
            <span class="n-list__name">{p.data.client}</span>
            <span class="n-list__desc">{p.data.intro}</span>
            <span class="n-list__year">{p.data.year}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Next>

<script>
  // Videos play only while on screen, and never with reduced motion
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.n-video')];
  if (reduce) videos.forEach((v) => { v.controls = true; v.preload = 'metadata'; });
  else {
    const io = new IntersectionObserver((entries) => entries.forEach(({ target, isIntersecting }) => {
      const v = target as HTMLVideoElement;
      if (isIntersecting) v.play().catch(() => {}); else v.pause();
    }), { threshold: 0.3 });
    videos.forEach((v) => io.observe(v));
  }
</script>
