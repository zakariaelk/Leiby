---
// Case studies (/work/<slug>/), on version A's case template in the blue colours
// (components/next/va/CaseA.astro). "Next project" follows the home page order and wraps around.
import CaseA from '../../components/next/va/CaseA.astro';
import { getProjects } from '../../lib/data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({ params: { slug: project.id }, props: { project, next: projects[(i + 1) % projects.length] } }));
}

const { project, next } = Astro.props;
---
<CaseA project={project} next={next} base="/" look="blue" compare={project.id === 'mitigating-risk-with-location-based-alerts' ? 'full' : undefined} />
