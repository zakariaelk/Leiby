---
// The INSO case in its short version (src/content/lab/inso-app-short.mdoc), for comparing with the
// full one: same template and media, with the one-minute story as the cover (behind a play button); not listed on the home page or in "Next project" links, and,
// like the whole site for now, noindex. Remove with the comparison bar once a version is chosen.
import { getEntry } from 'astro:content';
import CaseA from '../../components/next/va/CaseA.astro';
import { getProjects } from '../../lib/data';

const project = (await getEntry('lab', 'inso-app-short'))!;
const next = (await getProjects()).find((p) => p.id === 'ngosafety-website-redesign')!;
---
<CaseA project={project} next={next} base="/" look="blue" compare="short" heroPlayer="/media/projects/mitigating-risk-with-location-based-alerts/inso-app-one-alert-story.mp4" />
