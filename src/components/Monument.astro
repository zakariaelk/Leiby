---
// Line icons for the cities: Hassan II Mosque (Casablanca), Great Wall (Beijing), Erasmus Bridge (Rotterdam).
// Colours: the mosque's green roof tiles, China red, the Erasmus Bridge's light blue.
interface Props { city: string; size?: number; class?: string }
const { city, size = 40, class: cls } = Astro.props;
const key = city.toLowerCase();
---
<svg class:list={['monument', cls]} width={size} height={size} viewBox="0 0 64 64" fill="none" stroke="var(--ink)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {key === 'casablanca' && (
    <g>
      <path d="M2 57h60" />
      <!-- prayer hall with green roof -->
      <path d="M5 40l4-6h22l3 6Z" fill="var(--casablanca)" />
      <path d="M7 40h26v17H7Z" />
      <path d="M11 57v-7a3 3 0 0 1 6 0v7M22 57v-7a3 3 0 0 1 6 0v7" />
      <!-- minaret -->
      <path d="M36 57V13h11v44Z" />
      <path d="M38.5 16h6v9h-6ZM38.5 30h6v7h-6Z" fill="var(--casablanca)" stroke-width="1.6" />
      <path d="M39 50v-5a2.5 2.5 0 0 1 5 0v5" />
      <path d="M38.5 13V7h6v6" />
      <path d="M41.5 7V1.5" />
      <circle cx="41.5" cy="3" r="1" fill="var(--ink)" stroke="none" />
    </g>
  )}
  {key === 'beijing' && (
    <g>
      <path d="M2 57h60" />
      <!-- wall going up the hill on both sides -->
      <path d="M2 48l20-10v9L2 57" />
      <path d="M2.5 44.5l19-9.5" stroke-width="4.5" stroke-dasharray="2.6 2.6" stroke-linecap="butt" />
      <path d="M62 44l-20-8v9l20 8" />
      <path d="M61.5 40.5l-19-7.6" stroke-width="4.5" stroke-dasharray="2.6 2.6" stroke-linecap="butt" />
      <!-- watchtower -->
      <path d="M22 57V24h20v33Z" fill="var(--beijing)" />
      <path d="M20 24v-6h4v3h4v-3h4v3h4v-3h4v3h4v-3" fill="none" />
      <path d="M20 24h24" />
      <path d="M28.5 57v-8a3.5 3.5 0 0 1 7 0v8" fill="var(--paper)" />
      <path d="M26 31h3M35 31h3" stroke-width="2" />
    </g>
  )}
  {key === 'rotterdam' && (
    <g>
      <path d="M2 60c5-3 9 3 14 0s9 3 14 0 9 3 14 0 9 3 14 0" stroke-width="2" />
      <!-- cables -->
      <g stroke-width="1.3">
        <path d="M40 10 6 45M39 14 13 45M38 18 20 45M37 22 27 45" />
        <path d="M41 7 52 45M41 7 58 45" />
      </g>
      <!-- deck -->
      <path d="M2 45h60" stroke-width="3.4" />
      <path d="M12 45v10M52 45v10" />
      <!-- the "Swan" pylon, bent at the knee -->
      <path d="M31 45 35.5 26 41 6M40 45l-4.5-19" stroke="var(--rotterdam)" stroke-width="4.2" />
    </g>
  )}
</svg>

<style>
  .monument { flex: none; overflow: visible; }
</style>
