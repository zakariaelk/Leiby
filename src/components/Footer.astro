---
import Wave from './Wave.astro';
import GetInTouch from './GetInTouch.astro';
import BridgeBuild from './BridgeBuild.astro';
import settings from '../content/pages/settings.json';
import { themeFor } from '../lib/variant';

const { theme } = themeFor(Astro.url.pathname);

const year = new Date().getFullYear();
---
<footer class="site-footer" id="contact">
  <Wave color="var(--sun)" />
  <div class="bg-sun">
    <div class="container contact">
      <div class="contact__text-col">
        <p class="eyebrow" data-reveal>Get in touch</p>
        <h2 class="contact__title" data-reveal>{settings.contactTitle}</h2>
        <p class="lead contact__text" data-reveal>{settings.contactText}</p>

        <div class="contact__actions" data-reveal>
          <GetInTouch />
          <a href={settings.linkedin} class="social-btn" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.05c.53-1 1.84-2.05 3.78-2.05 4.04 0 4.79 2.66 4.79 6.12V21h-4v-5c0-1.2-.02-2.73-1.66-2.73-1.67 0-1.92 1.3-1.92 2.64V21h-4V9.75Z"/></svg>
          </a>
        </div>
        <p class="contact__status"><span class="dot" aria-hidden="true"></span>{settings.availability}</p>
      </div>
      {theme !== 'bridge' && <div class="contact__art"><BridgeBuild /></div>}
    </div>
  </div>
  <div class="site-footer__bar">
    <div class="container site-footer__bar-inner">
      <span>© {year} {settings.name}</span>
      <span>{settings.role}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: auto; }
  .contact {
    position: relative; display: grid; gap: 3rem; align-items: end;
    padding-block: clamp(2.5rem, 5vw, 5rem) clamp(3.5rem, 7vw, 6rem);
  }
  @media (min-width: 900px) { .contact { grid-template-columns: 1.4fr 1fr; } }
  .contact .eyebrow { color: var(--ink); }
  .contact__title { font-size: var(--fs-h1); letter-spacing: -0.045em; max-width: 16ch; }
  .contact__text { margin-top: 1.5rem; max-width: 44ch; opacity: 0.85; }
  .contact__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2.25rem; }
  .social-btn {
    width: 48px; height: 48px; display: grid; place-items: center; border-radius: 12px;
    background: var(--ink); color: var(--white); transition: transform 0.3s var(--ease-bounce), background 0.2s;
  }
  .social-btn svg { width: 22px; }
  .social-btn:hover { transform: rotate(-8deg) scale(1.08); background: var(--coral); }
  .contact__status { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.75rem; font-weight: var(--fw-medium); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: #0a7a4b; animation: ping 2s infinite; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(10, 122, 75, 0.5); } 80%, 100% { box-shadow: 0 0 0 10px rgba(10, 122, 75, 0); } }
  .contact__art { width: 100%; max-width: 380px; justify-self: end; }
  @media (max-width: 899px) { .contact__art { max-width: 280px; } }

  .site-footer__bar { font-size: var(--fs-small); color: rgba(255, 255, 255, 0.75); background: var(--ink); }
  .site-footer__bar-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; padding-block: 1.1rem; }
</style>
