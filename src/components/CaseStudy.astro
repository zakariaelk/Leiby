---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import Wave from './Wave.astro';
import { themeFor } from '../lib/variant';

interface Props { project: CollectionEntry<'projects'>; next: CollectionEntry<'projects'>; prev: CollectionEntry<'projects'> }
const { project, next, prev } = Astro.props;
const { base } = themeFor(Astro.url.pathname);
const { Content, headings } = await render(project);
const d = project.data;
const toc = headings.filter((h) => h.depth === 2);
const meta = [
  { label: 'Sector', value: d.sector },
  { label: 'Role', value: d.role },
  { label: 'Duration', value: d.duration },
].filter((m) => m.value);
---
<Base title={d.title} description={d.intro}>
  <section class="case-hero bg-sun">
    <div class="container case-hero__grid">
      <div class="case-hero__text">
        <a href={`${base}/#work`} class="arrow-link case-hero__back"><span class="arrow" aria-hidden="true">←</span> All work</a>
        <p class="case-hero__client">{d.client}</p>
        <h1 class="case-hero__title">{d.headline}</h1>
        <p class="lead case-hero__intro">{d.intro}</p>
      </div>
      <dl class="case-meta">
        {meta.map((m) => (
          <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
        ))}
        {d.link && (
          <div>
            <dt>Take a look</dt>
            <dd><a href={d.link} target="_blank" rel="noopener" class="arrow-link">{d.link.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} <span class="arrow arrow--up" aria-hidden="true">→</span></a></dd>
          </div>
        )}
      </dl>
    </div>
  </section>

  <div class="case-cover">
    <div class="case-cover__bg" aria-hidden="true"><div class="bg-sun"></div><Wave /></div>
        <div class="container">
      <div class="case-cover__img">
        <Image src={d.cover} alt={`${d.title} cover`} widths={[640, 1024, 1440, 1920]} sizes="(min-width: 1440px) 1360px, 100vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </div>

  <section class="section case-body">
    <div class:list={['container case-body__grid', toc.length > 2 && 'has-toc']}>
      {toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc__title">On this page</p>
          <ol role="list">
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  <section class="section case-next" aria-label="More projects">
    <div class="container">
      <div class="case-next__head">
        <p class="eyebrow">Next up</p>
        <a href={`${base}/#work`} class="arrow-link">All work <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="case-next__grid">
        <ProjectCard project={next} />
        {prev.id !== next.id && <ProjectCard project={prev} delay={0.08} />}
      </div>
    </div>
  </section>
</Base>

<script>
  // Highlight the current section in the table of contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((a) => a.classList.toggle('is-active', a.hash === `#${e.target.id}`));
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .case-hero { position: relative; padding-top: calc(var(--header-h) + clamp(1.5rem, 4vw, 3.5rem)); padding-bottom: clamp(2rem, 4vw, 3rem); background: radial-gradient(55% 90% at 95% 0%, rgba(255, 90, 54, 0.28), rgba(255, 90, 54, 0) 70%), var(--sun); }
  .case-hero__grid { display: grid; gap: 2rem 4rem; align-items: end; }
  @media (min-width: 1024px) { .case-hero__grid { grid-template-columns: 1.6fr 1fr; } }
  .case-hero__back { font-size: var(--fs-small); margin-bottom: 1.5rem; }
  .case-hero__back:hover .arrow { transform: translateX(-5px); }
  .case-hero__client { font-weight: var(--fw-bold); color: var(--ink); font-size: var(--fs-h3); letter-spacing: -0.02em; }
  .case-hero__title { font-size: var(--fs-h1); letter-spacing: -0.045em; margin-top: 0.5rem; max-width: 16ch; }
  .case-hero__intro { margin-top: 1.25rem; max-width: 40ch; }
  .case-meta { display: grid; gap: 1rem 2rem; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
  @media (min-width: 1024px) { .case-meta { grid-template-columns: 1fr; gap: 0.9rem; } }
  .case-meta div { border-top: 2px solid var(--ink); padding-top: 0.6rem; }
  .case-meta dt { font-size: var(--fs-small); font-weight: var(--fw-bold); text-transform: uppercase; letter-spacing: 0.08em; }
  .case-meta dd { margin: 0.2rem 0 0; font-weight: var(--fw-medium); }

  .case-cover { position: relative; }
  .case-cover__bg { position: absolute; inset: -1px 0 auto; height: 50%; display: grid; grid-template-rows: 1fr auto; }
  .case-cover .container { position: relative; }
  .case-cover__img { border-radius: var(--radius-lg); overflow: hidden; background: var(--coral); box-shadow: 8px 8px 0 0 var(--coral); }
  .case-cover__img :global(img) { width: 100%; height: auto; }

  .case-body__grid { display: grid; gap: 3rem; }
  @media (min-width: 1100px) {
    .case-body__grid.has-toc { grid-template-columns: 240px minmax(0, 1fr); gap: clamp(3rem, 6vw, 6rem); }
  }
  .toc { display: none; }
  @media (min-width: 1100px) {
    .toc { display: block; position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; max-height: calc(100vh - var(--header-h) - 4rem); overflow-y: auto; }
  }
  .toc__title { font-size: var(--fs-small); font-weight: var(--fw-bold); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.9rem; }
  .toc ol { display: grid; gap: 0.15rem; }
  .toc a {
    display: block; text-decoration: none; padding: 0.35rem 0 0.35rem 1rem; line-height: 1.3; font-size: 0.95rem;
    color: var(--ink-soft); border-left: 3px solid var(--line); transition: color 0.2s, border-color 0.2s;
  }
  .toc a:hover { color: var(--ink); }
  .toc a.is-active { color: var(--ink); border-color: var(--coral); font-weight: var(--fw-medium); }

  .case-next { background: var(--white); }
  .case-next__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .case-next__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 700px) { .case-next__grid { grid-template-columns: repeat(2, 1fr); } }
</style>
