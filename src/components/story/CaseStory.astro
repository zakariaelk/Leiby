---
// Story case study template (docs/case-study-design-brief-for-claude-code.md).
// Reading depths: 30 s (At a glance, callouts, figures), 3 min (+ headings), full read.
// Navigation: a slim left rail on wide screens, a top bar with a section sheet below that.
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Story from '../../layouts/Story.astro';
import { splitConfirm } from '../../lib/media';

interface Props { project: CollectionEntry<'projects'>; next: CollectionEntry<'projects'> }
const { project, next } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);

// Rail labels: the short names from the CMS menu, matched to the headings by their text
const norm = (s: string) => s.toLowerCase().replace(/[’']/g, "'").replace(/[^a-z0-9']+/g, ' ').trim();
const short = new Map(d.menu.flatMap((g) => g.items).map((it) => [norm(it.heading), it.label]));
const sections = [
  { id: 'at-a-glance', label: 'At a glance' },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: short.get(norm(h.text)) ?? h.text })),
];

const meta = [
  { label: 'Sector', value: d.sector },
  { label: 'Role', value: d.role },
  { label: 'Duration', value: d.duration },
  { label: 'Team', value: d.team },
].filter((m) => m.value);
const linkLabel = d.link?.replace(/^https?:\/\/(www\.)?/i, '').replace(/\/$/, '');
---
<Story title={d.title} description={d.intro}>
  <nav class="cs-rail" aria-label="Sections">
    <ol>
      {sections.map((s) => (
        <li><a href={`#${s.id}`} data-section={s.id}><span class="cs-rail__tick" aria-hidden="true"></span><span class="cs-rail__label">{s.label}</span></a></li>
      ))}
    </ol>
    <a class="cs-rail__top" href="#top">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
      <span class="cs-rail__label">Back to top</span>
    </a>
  </nav>

  <div class="cs-bar" data-bar>
    <button type="button" class="cs-bar__btn" aria-haspopup="dialog" aria-controls="cs-sheet">
      <span class="cs-bar__current" data-current>{sections[0].label}</span>
      <span class="cs-bar__hint">Sections</span>
      <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M2 1.5h8L6 6.5z" /></svg>
    </button>
    <div class="cs-bar__progress" aria-hidden="true"><span data-progress></span></div>
  </div>

  <dialog id="cs-sheet" class="cs-sheet" aria-labelledby="cs-sheet-title">
    <div class="cs-sheet__head">
      <p id="cs-sheet-title" class="cs-sheet__title">Sections</p>
      <button type="button" class="cs-sheet__close" data-close>Close</button>
    </div>
    <ol>
      {sections.map((s) => <li><a href={`#${s.id}`} data-section={s.id}>{s.label}</a></li>)}
    </ol>
    <a class="cs-sheet__top" href="#top">Back to top</a>
  </dialog>

  <main id="main" class="cs">
    <article>
      <header class="cs-hero cs-grid">
        <h1 class="cs-hero__title">{d.headline}</h1>
        <p class="cs-hero__sub">{d.intro}</p>
        <dl class="cs-meta">
          {meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{splitConfirm(m.value).map((p) => p.confirm ? <mark class="cs-confirm"><strong>Confirm:</strong> {p.text}</mark> : p.text)}</dd>
            </div>
          ))}
          {d.link && (
            <div>
              <dt>Take a look</dt>
              <dd><a href={d.link} target="_blank" rel="noopener noreferrer">{linkLabel}<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></dd>
            </div>
          )}
        </dl>
        <div class="cs-hero__visual">
          <Image src={d.cover} alt="The redesigned INSO app on a phone: the alerts list with search, filters and spaced alert cards." widths={[640, 960, 1280, 1680]} sizes="(min-width: 1200px) 1140px, 100vw" loading="eager" fetchpriority="high" />
        </div>
      </header>

      <div class="cs-body cs-grid"><Content /></div>

      <nav class="cs-next cs-grid" aria-label="Next case study">
        <div class="cs-next__inner">
          <p class="cs-next__label">Next case study</p>
          <a href={`/work/${next.id}/`} class="cs-next__link">{next.data.headline}<span aria-hidden="true"> →</span></a>
        </div>
      </nav>
    </article>
  </main>
</Story>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Videos: play only while on screen; with reduced motion they wait for the play button
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.cs-video')];
  if (reduce.matches) {
    videos.forEach((v) => { v.controls = true; v.preload = 'metadata'; });
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        const v = target as HTMLVideoElement;
        if (isIntersecting) v.play().catch(() => { v.controls = true; });
        else v.pause();
      });
    }, { threshold: 0.35 });
    videos.forEach((v) => io.observe(v));
  }

  // Anchor link on every section heading
  document.querySelectorAll<HTMLElement>('.cs-body h2[id], .cs-body h3[id], .cs-glance__title').forEach((h) => {
    const a = document.createElement('a');
    a.className = 'cs-anchor';
    a.href = `#${h.id}`;
    a.textContent = '#';
    a.setAttribute('aria-label', `Link to this section: ${h.textContent?.trim()}`);
    h.append(' ', a);
  });

  // Scroll-spy: the current section is the last one whose heading passed the top third
  const ids = [...new Set([...document.querySelectorAll<HTMLAnchorElement>('[data-section]')].map((a) => a.dataset.section!))];
  const targets = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section]')];
  const bar = document.querySelector<HTMLElement>('[data-bar]')!;
  const current = document.querySelector<HTMLElement>('[data-current]')!;
  const progress = document.querySelector<HTMLElement>('[data-progress]')!;
  const hero = document.querySelector<HTMLElement>('.cs-hero')!;
  const article = document.querySelector<HTMLElement>('.cs-body')!;
  let active = '';
  let ticking = false;
  const update = () => {
    ticking = false;
    const line = window.innerHeight * 0.33;
    let id = '';
    targets.forEach((t) => { if (t.getBoundingClientRect().top < line) id = t.id; });
    if (id !== active) {
      active = id;
      links.forEach((a) => (a.dataset.section === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      const label = links.find((a) => a.dataset.section === id)?.textContent?.trim();
      current.textContent = label || 'Sections';
    }
    const r = article.getBoundingClientRect();
    const done = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - window.innerHeight)));
    progress.style.transform = `scaleX(${done})`;
    bar.classList.toggle('is-shown', hero.getBoundingClientRect().bottom < 0);
  };
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
  update();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);

  // Section sheet (small screens): a modal dialog, so focus, Escape and the backdrop come for free
  const sheet = document.querySelector<HTMLDialogElement>('#cs-sheet')!;
  document.querySelector('.cs-bar__btn')?.addEventListener('click', () => sheet.showModal());
  sheet.querySelector('[data-close]')?.addEventListener('click', () => sheet.close());
  sheet.addEventListener('click', (e) => {
    if (e.target === sheet || (e.target as HTMLElement).closest('a')) sheet.close();
  });
</script>
