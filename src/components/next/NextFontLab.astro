---
// Font test: open any /next/ page with ?fonts and a small panel swaps the serif and the sans on
// the real pages (header, hero, cards, case study), to find a free pair close to hansonwu.com
// (Martina Plantijn + Söhne, both by Klim, paid). The candidates load from Google Fonts only in
// this mode. The choice is remembered while you browse; "Close" switches back to normal.
const SERIFS = [
  ['Newsreader Variable', 'Newsreader (now)'],
  ['Source Serif 4', 'Source Serif 4'],
  ['Literata', 'Literata'],
  ['Crimson Pro', 'Crimson Pro'],
  ['Spectral', 'Spectral'],
  ['EB Garamond', 'EB Garamond'],
];
const SANS = [
  ['Hanken Grotesk Variable', 'Hanken Grotesk (now)'],
  ['Geist', 'Geist'],
  ['Inter', 'Inter'],
  ['Instrument Sans', 'Instrument Sans'],
  ['Schibsted Grotesk', 'Schibsted Grotesk'],
];
const PAIRS = [
  ['Newsreader Variable', 'Hanken Grotesk Variable', 'Now'],
  ['Source Serif 4', 'Geist', 'Closest to Hanson Wu'],
  ['Literata', 'Inter', 'Sturdy book + neutral'],
  ['Crimson Pro', 'Instrument Sans', 'Lighter, more elegant'],
  ['Spectral', 'Schibsted Grotesk', 'Sharper, more character'],
];
---
<aside class="n-fontlab" aria-label="Font test" hidden>
  <button type="button" class="n-fontlab__title" aria-expanded="true">Font test <span>vs. hansonwu.com: Martina Plantijn + Söhne (paid) · click to fold</span></button>
  <div class="n-fontlab__pairs">
    {PAIRS.map(([serif, sans, note]) => (
      <button type="button" data-serif={serif} data-sans={sans}>
        <strong>{serif.replace(' Variable', '')} + {sans.replace(' Variable', '')}</strong><span>{note}</span>
      </button>
    ))}
  </div>
  <label>Serif <select data-role="serif">{SERIFS.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
  <label>Sans <select data-role="sans">{SANS.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
  <button type="button" class="n-fontlab__close" data-close>Close</button>
</aside>

<script>
  const KEY = 'ze-fontlab';
  const FONTS = 'https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&family=Crimson+Pro:ital,wght@0,200..900;1,200..900&family=Spectral:ital,wght@0,400;0,500;1,400&family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Inter:opsz,wght@14..32,100..900&family=Geist:wght@100..900&family=Instrument+Sans:wght@400..700&family=Schibsted+Grotesk:wght@400..900&display=swap';
  const panel = document.querySelector<HTMLElement>('.n-fontlab');
  const read = () => { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; } };
  const save = (v: unknown) => { try { v ? localStorage.setItem(KEY, JSON.stringify(v)) : localStorage.removeItem(KEY); } catch {} };
  let state = read();
  if (new URLSearchParams(location.search).has('fonts') && !state) state = { serif: 'Newsreader Variable', sans: 'Hanken Grotesk Variable' };

  if (panel && state) {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = FONTS;
    document.head.append(link);
    document.documentElement.classList.add('is-fontlab');
    panel.hidden = false;
    const selS = panel.querySelector<HTMLSelectElement>('[data-role="serif"]')!;
    const selN = panel.querySelector<HTMLSelectElement>('[data-role="sans"]')!;
    const apply = () => {
      const root = document.documentElement.style;
      root.setProperty('--serif', `'${state.serif}', Georgia, serif`);
      root.setProperty('--sans', `'${state.sans}', system-ui, sans-serif`);
      selS.value = state.serif;
      selN.value = state.sans;
      panel.querySelectorAll<HTMLButtonElement>('[data-serif]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.serif === state.serif && b.dataset.sans === state.sans)));
      save(state);
    };
    apply();
    selS.addEventListener('change', () => { state.serif = selS.value; apply(); });
    selN.addEventListener('change', () => { state.sans = selN.value; apply(); });
    panel.querySelectorAll<HTMLButtonElement>('[data-serif]').forEach((b) => b.addEventListener('click', () => { state = { serif: b.dataset.serif, sans: b.dataset.sans }; apply(); }));
    const title = panel.querySelector<HTMLButtonElement>('.n-fontlab__title')!;
    title.addEventListener('click', () => { const min = panel.classList.toggle('is-min'); title.setAttribute('aria-expanded', String(!min)); });
    panel.querySelector('[data-close]')?.addEventListener('click', () => {
      save(null);
      const url = new URL(location.href);
      url.searchParams.delete('fonts');
      location.href = url.toString();
    });
  }
</script>
