---
// Version A home (the chosen direction), also behind every /tests page. A one-sentence intro with
// my name (its speaker sits on the last "a"), then each featured project on its own sheet, the rest
// of the work as a list on gray paper (hovering a row shows its cover), a short About and contact.
// featured: how each featured project is shown
//   'split'        short title + Industry / Role on the left, a big visual on the right (default)
//   'client'       the same, with the client above the title and only the role below it
//   'screen-1..3'  one screen per project: a big title over a visual sized to fit the screen;
//                  2 adds the client as a paper tab on the visual, 3 puts Role / For beside the title
// button: a round paper button with an arrow under each featured project's facts (black, blue, black)
// highlight: "designer" and "builder" get the hand-drawn marker of zakariaelk.com, in the logo blue
//   (or 'peach', the colour on zakariaelk.com)
import { getImage } from 'astro:assets';
import Next from '../../../layouts/Next.astro';
import FramedMedia from '../FramedMedia.astro';
import ContactA from './ContactA.astro';
import IntroA from './IntroA.astro';
import { blob, cutMask, tabCut, unevenRect } from '../../../lib/papercut';
import { workList, caseHref, EXPERTISE, SHORT_TITLES } from '../../../lib/versions';
import '../../../styles/next-a.css';

type Featured = 'split' | 'client' | 'screen-1' | 'screen-2' | 'screen-3';
// intro: the opening animation (the home page only, not the tests)
interface Props { featured?: Featured; highlight?: 'blue' | 'peach' | false; title?: string; intro?: boolean; button?: boolean }
const { featured: layout = 'split', highlight = 'blue', title = 'Zakaria El Khachia · Product designer & builder', intro = false, button = false } = Astro.props;

const base = '/next/a/';
const { featured, more } = await workList();
const screen = layout.startsWith('screen');
const titleOf = (p: (typeof featured)[number]['p']) => SHORT_TITLES[p.id] ?? p.data.statement ?? p.data.intro;
const orgOf = (p: (typeof featured)[number]['p']) => p.data.org ?? p.data.client;
// covers for the list's hover preview, loaded on the first hover
const peeks = await Promise.all(more.map(async (p) => (await getImage({ src: p.data.cover, width: 720, format: 'webp' })).src));
const sentence = "I'm Zakaria El Khachia, a product designer and builder. I spent the last five years at INSO making safety information clearer for humanitarian workers in conflict zones.";
const mark = highlight ? ['a-mark', highlight === 'peach' && 'a-mark--peach'] : [];
---
<Next base={base} variant="a" logo work="#work" intro={intro} title={title} description="Product designer and builder. Most recently, safety tools for humanitarian workers at INSO.">
  <section class="a-hero a-wrap">
    <h1 class="a-statement" aria-label={sentence}>I'm Zakaria El Khachi<span class="a-say-a">a<button type="button" class="n-say a-say" aria-label="Hear how to say Zakaria El Khachia" data-audio="/audio/zakaria-el-khachia.m4a"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3l4.5-4v13L7 14.5H4z" /><path class="wave" d="M15 9.2a4 4 0 0 1 0 5.6" /><path class="wave" d="M17.8 6.6a7.6 7.6 0 0 1 0 10.8" /></svg></button></span>, a product <span class:list={mark}>designer</span> and <span class:list={mark}>builder</span>. I spent the last five years at INSO making safety information clearer for humanitarian workers in conflict zones.</h1>
  </section>

  <section class="a-work" id="work" aria-labelledby="work-title">
    <h2 class="sr-only" id="work-title">Featured work</h2>
    {featured.map(({ p, video, poster, posterSrc }, i) => (
      <div class="n-band n-band--light a-band">
        <div class="n-cut n-cut--top" style={cutMask(7 + i * 13)} aria-hidden="true"></div>
        <div class="a-wrap">
          {screen ? (
            <article class="a-screen">
              <a class="a-screen__link" href={caseHref(base, p.id)}>
                <div class:list={['a-screen__head', layout === 'screen-3' && 'a-screen__head--meta']}>
                  <h3 class="a-screen__title">{titleOf(p)}</h3>
                  {layout === 'screen-3' && (
                    <dl class="a-meta">
                      {p.data.role && <div><dt>Role</dt><dd>{p.data.role}</dd></div>}
                      <div><dt>For</dt><dd>{orgOf(p)}</dd></div>
                    </dl>
                  )}
                </div>
                <div class="a-screen__visual">
                  {layout === 'screen-2' && <span class="n-tag a-screen__client" style={`--tab:${tabCut(5 + i * 4)}`}>{orgOf(p)}</span>}
                  <FramedMedia frame={false} cut={unevenRect(31 + i * 7, 0.6)} image={poster ?? p.data.cover} video={video} posterSrc={posterSrc} alt={`${orgOf(p)}: ${p.data.projectName ?? p.data.title}`} eager={i === 0} />
                </div>
              </a>
            </article>
          ) : (
            <article class="a-feat">
              <a class="a-feat__link" href={caseHref(base, p.id)}>
                {layout === 'client' && <p class="a-feat__client">{orgOf(p)}</p>}
                <h3 class="a-feat__title">{titleOf(p)}</h3>
                <div class="a-feat__meta">
                  <dl class="a-meta">
                    {layout === 'split' && p.data.sector && <div><dt>Industry</dt><dd>{p.data.sector}</dd></div>}
                    {p.data.role && <div><dt>Role</dt><dd>{p.data.role}</dd></div>}
                  </dl>
                  {button && (
                    <span class:list={['a-go', i % 2 ? 'a-go--blue' : 'a-go--black']} aria-hidden="true">
                      <svg viewBox="0 0 100 100"><path class="a-go__shape" d={blob(41 + i * 6, 50, 50, 46)} /><path class="a-go__arrow" d="M30 50h40M56 36l14 14-14 14" /></svg>
                    </span>
                  )}
                </div>
                <div class="a-feat__visual">
                  <FramedMedia frame={false} cut={unevenRect(31 + i * 7, 0.8)} image={poster ?? p.data.cover} video={video} posterSrc={posterSrc} alt={`${orgOf(p)}: ${p.data.projectName ?? p.data.title}`} sizes="(min-width: 900px) 54vw, 92vw" eager={i === 0} />
                </div>
              </a>
            </article>
          )}
        </div>
      </div>
    ))}
  </section>

  <div class="n-band a-band--gray">
    <div class="n-cut n-cut--top" style={cutMask(53)} aria-hidden="true"></div>
    <section class="n-list n-wrap a-selected" aria-labelledby="more-label" data-peek-list>
      <h2 class="n-label" id="more-label"><span class="n-tag" style={`--tab:${tabCut(19)}`}>Selected Work</span></h2>
      <ul>
        {more.map((p, i) => (
          <li>
            <a href={caseHref(base, p.id)} data-peek={i}>
              <span class="n-list__name">{p.data.client}</span>
              <span class="n-list__desc">{p.data.intro}</span>
              <span class="n-list__year">{p.data.year}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <div class="n-cut n-cut--bottom" style={cutMask(61)} aria-hidden="true"></div>
  </div>

  <section class="a-about a-wrap" aria-label="About">
    <div>
      <h2 class="a-label">About</h2>
      <p>I've been designing and building for the web and mobile for over twelve years, from agency work in Beijing to safety tools for humanitarian workers at INSO in The Hague.</p>
      <p>Because I started out writing code, I still build a lot of what I design, so there are fewer surprises between the mockup and what people actually get to use.</p>
      <p><a class="a-arrow-link" href={`${base}about/`}>More about me</a></p>
    </div>
    <div>
      <h2 class="a-label">Expertise</h2>
      <ul class="a-list">{EXPERTISE.map((e) => <li>{e}</li>)}</ul>
    </div>
  </section>

  <ContactA />

  {intro && <IntroA />}

  <!-- the list's hover preview: outside the paper bands, whose filters would trap a fixed position -->
  <div class="a-peek" aria-hidden="true">
    <div class="a-peek__card" style={`--cut:${unevenRect(77, 0.6)}`}>
      {peeks.map((src) => <img data-src={src} alt="" width="720" height="432" decoding="async" />)}
    </div>
  </div>
</Next>

<script>
  import '../../../scripts/list-peek';
  // highlight: the marker is drawn shortly after the page appears ("builder" follows "designer"),
  // after the intro when there is one
  const draw = () => window.setTimeout(() => document.querySelectorAll('.a-mark').forEach((m) => m.classList.add('is-drawn')), 300);
  if (document.documentElement.classList.contains('is-intro')) document.addEventListener('ze:intro-done', draw, { once: true });
  else window.setTimeout(draw, 200);
</script>
