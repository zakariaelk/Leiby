---
// Version A home (the chosen direction), also behind every /tests page. A one-sentence intro, then
// the featured work, the rest of the work in two columns, a short About and a way to get in touch.
// featured: how each featured project is shown
//   'split'        short title + Industry / Role on the left, a big visual on the right (default)
//   'client'       the same, with the client above the title and only the role below it
//   'screen-1..3'  one screen per project: a big title over a visual sized to fit the screen;
//                  2 adds the client as a paper tab on the visual, 3 puts Role / For beside the title
// highlight: "designer" and "builder" get the hand-drawn marker of zakariaelk.com
import { Image } from 'astro:assets';
import Next from '../../../layouts/Next.astro';
import FramedMedia from '../FramedMedia.astro';
import ContactA from './ContactA.astro';
import { cutMask, tabCut } from '../../../lib/papercut';
import { workList, caseHref, EXPERTISE, SHORT_TITLES } from '../../../lib/versions';
import '../../../styles/next-a.css';

type Featured = 'split' | 'client' | 'screen-1' | 'screen-2' | 'screen-3';
interface Props { featured?: Featured; highlight?: boolean; title?: string }
const { featured: layout = 'split', highlight = false, title = 'Zakaria El Khachia · Product designer & builder' } = Astro.props;

const base = '/next/a/';
const { featured, more } = await workList();
const screen = layout.startsWith('screen');
const titleOf = (p: (typeof featured)[number]['p']) => SHORT_TITLES[p.id] ?? p.data.statement ?? p.data.intro;
const orgOf = (p: (typeof featured)[number]['p']) => p.data.org ?? p.data.client;
---
<Next base={base} variant="a" logo work="#work" title={title} description="Product designer and creative builder. Most recently, safety tools for humanitarian workers at INSO.">
  <section class="a-hero a-wrap">
    {highlight ? (
      <h1 class="a-statement">I'm Zakaria, a product <span class="a-mark">designer</span> and creative <span class="a-mark">builder</span>. I spent the last five years at INSO making safety information clearer for humanitarian workers in conflict zones.</h1>
    ) : (
      <h1 class="a-statement">I'm Zakaria, a product designer and creative builder. I spent the last five years at INSO making safety information clearer for humanitarian workers in conflict zones.</h1>
    )}
  </section>

  <section class="a-work" id="work" aria-labelledby="work-title">
    <div class="n-band n-band--light a-sheet">
      <div class="n-cut n-cut--top" style={cutMask(7)} aria-hidden="true"></div>
      <h2 class="sr-only" id="work-title">Selected work</h2>
      <div class="a-wrap a-featured">
        {featured.map(({ p, video, poster, posterSrc }, i) => screen ? (
          <article class="a-screen">
            <a class="a-screen__link" href={caseHref(base, p.id)}>
              <div class:list={['a-screen__head', layout === 'screen-3' && 'a-screen__head--meta']}>
                <h3 class="a-screen__title">{titleOf(p)}</h3>
                {layout === 'screen-3' && (
                  <dl class="a-meta">
                    {p.data.role && <div><dt>Role</dt><dd>{p.data.role}</dd></div>}
                    <div><dt>For</dt><dd>{orgOf(p)}</dd></div>
                  </dl>
                )}
              </div>
              <div class="a-screen__visual">
                {layout === 'screen-2' && <span class="n-tag a-screen__client" style={`--tab:${tabCut(5 + i * 4)}`}>{orgOf(p)}</span>}
                <FramedMedia frame={false} image={poster ?? p.data.cover} video={video} posterSrc={posterSrc} alt={`${orgOf(p)}: ${p.data.projectName ?? p.data.title}`} eager={i === 0} />
              </div>
            </a>
          </article>
        ) : (
          <article class="a-feat">
            <a class="a-feat__link" href={caseHref(base, p.id)}>
              {layout === 'client' && <p class="a-feat__client">{orgOf(p)}</p>}
              <h3 class="a-feat__title">{titleOf(p)}</h3>
              <dl class="a-meta a-feat__meta">
                {layout === 'split' && p.data.sector && <div><dt>Industry</dt><dd>{p.data.sector}</dd></div>}
                {p.data.role && <div><dt>Role</dt><dd>{p.data.role}</dd></div>}
              </dl>
              <div class="a-feat__visual">
                <FramedMedia frame={false} image={poster ?? p.data.cover} video={video} posterSrc={posterSrc} alt={`${orgOf(p)}: ${p.data.projectName ?? p.data.title}`} sizes="(min-width: 900px) 54vw, 92vw" eager={i === 0} />
              </div>
            </a>
          </article>
        ))}

        <div class="a-more">
          {more.map((p) => (
            <article class="a-card">
              <a class="a-project__link" href={caseHref(base, p.id)}>
                <Image class="a-card__img" src={p.data.cover} alt={`${p.data.client}: ${p.data.title}`} widths={[480, 720, 1000]} sizes="(min-width: 900px) 45vw, 92vw" />
                <p class="a-project__org">{p.data.client} <span>· {p.data.year}</span></p>
                <h3 class="a-card__title">{p.data.intro}</h3>
              </a>
            </article>
          ))}
        </div>
      </div>
      <div class="n-cut n-cut--bottom" style={cutMask(91)} aria-hidden="true"></div>
    </div>
  </section>

  <section class="a-about a-wrap" aria-label="About">
    <div>
      <h2 class="a-label">About</h2>
      <p>I've been designing and building for the web and mobile for over twelve years, from agency work in Beijing to safety tools for humanitarian workers at INSO in The Hague.</p>
      <p>Because I started out writing code, I still build a lot of what I design, so there are fewer surprises between the mockup and what people actually get to use.</p>
      <p><a class="a-arrow-link" href={`${base}about/`}>More about me</a></p>
    </div>
    <div>
      <h2 class="a-label">Expertise</h2>
      <ul class="a-list">{EXPERTISE.map((e) => <li>{e}</li>)}</ul>
    </div>
  </section>

  <ContactA />
</Next>

<script>
  // highlight: the marker is drawn shortly after the page appears ("builder" follows "designer")
  window.setTimeout(() => document.querySelectorAll('.a-mark').forEach((m) => m.classList.add('is-drawn')), 500);
</script>
