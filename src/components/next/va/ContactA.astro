---
// Version A: the closing invitation and the footer, the same on every page (after hansonwu.com),
// on their own sheet of paper with the torn edge above.
import { cutMask } from '../../../lib/papercut';
import { settings } from '../../../lib/versions';
const year = new Date().getFullYear();
---
<div class="n-band n-band--light a-band--contact">
  <div class="n-cut n-cut--top" style={cutMask(83)} aria-hidden="true"></div>
  <section class="a-contact a-wrap" id="contact" aria-labelledby="contact-title">
    <h2 class="a-contact__title" id="contact-title">Want to work together?</h2>
    <p class="a-contact__text">{settings.availability}. Say hello at <a href={`mailto:${settings.email}`}>{settings.email}</a> or find me on <a href={settings.linkedin} target="_blank" rel="noopener">LinkedIn</a>.</p>
  </section>
  <footer class="a-foot a-wrap">
    <p>© {year} {settings.name}</p>
    <p><a href={`mailto:${settings.email}`}>Email</a><a href={settings.linkedin} target="_blank" rel="noopener">LinkedIn</a></p>
  </footer>
</div>
