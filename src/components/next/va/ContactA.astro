---
// Version A: the closing invitation and the footer, the same on every page (after hansonwu.com),
// on their own sheet of paper with the torn edge above: the question with the email behind
// "connect", LinkedIn and the CV (in the footer row on desktop), then the copyright under a
// full-width rule.
import { cutMask } from '../../../lib/papercut';
import { settings, CV } from '../../../lib/versions';
const year = new Date().getFullYear();
---
<div class="n-band n-band--light a-band--contact">
  <div class="n-cut n-cut--top" style={cutMask(83)} aria-hidden="true"></div>
  <section class="a-contact a-wrap" id="contact" aria-labelledby="contact-title">
    <h2 class="a-contact__title" id="contact-title">Do you have a project in mind?<br /> Let's <a href={`mailto:${settings.email}`}>connect</a>.</h2>
    <div class="a-contact__row">
      <ul class="a-contact__links">
        <li><a href={settings.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={CV} target="_blank" rel="noopener">Download CV</a></li>
      </ul>
      <p class="a-status"><span class="a-status__dot" aria-hidden="true"></span>Open to perm roles &amp; new projects</p>
    </div>
  </section>
  <footer class="a-foot">
    <div class="a-wrap a-foot__row">
      <p>© {year} {settings.name}</p>
      <ul class="a-foot__links">
        <li><a href={settings.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={CV} target="_blank" rel="noopener">Download CV</a></li>
      </ul>
    </div>
  </footer>
</div>
