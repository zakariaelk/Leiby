---
// Version A intro (home page, once per visit): the logo pops in in the middle of the screen, spins
// for a second and a half in stop-motion steps, then flies to its spot in the header while the page appears,
// still spinning, and stops a moment after landing. It's the real logo (NextLogo, the header's
// seed), so the header logo can take over without a jump. Timeline in scripts/intro-a.ts; styles in
// next-a.css. Whether it plays is decided before the first paint (the inline script in layouts/Next.astro).
import NextLogo from '../NextLogo.astro';
---
<div class="a-intro" aria-hidden="true" data-intro>
  <NextLogo variant="blue" seed={23} size={220} decorative />
</div>

<script>
  import '../../../scripts/intro-a';
</script>
