---
// Header: logo, "say my name" speaker, nav, light/dark switch. Logo versions: 'mark' = Z + ز
// circles and the name (morphs into its Arabic form every few seconds); 'text' = the name alone;
// 'paper' = the Zakaria / زكرياء paper cut-outs, always open.
import ArabicNameAmiri from './ArabicNameAmiri.astro';
import NextLogo from './NextLogo.astro';
import NextLogoWord from './NextLogoWord.astro';

interface Props { logo?: 'mark' | 'text' | 'paper' }
const { logo = 'mark' } = Astro.props;
---
<header class="n-head">
  <div class:list={['n-brand', `n-brand--${logo}`]}>
    {logo === 'paper' ? (
      <NextLogoWord variant="blue" collapse={false} label="Zakaria El Khachia" />
    ) : (
      <>
        {logo === 'mark' && <NextLogo variant="blue" seed={23} size={52} decorative />}
        <a href="/next/" class="n-name">
          <span class="n-name__latin">Zakaria El Khachia</span>
          <ArabicNameAmiri />
        </a>
      </>
    )}
    <button type="button" class="n-icon n-say" aria-label="Hear how to say Zakaria El Khachia" data-audio="/audio/zakaria-el-khachia.m4a">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 9.5h3l4.5-4v13L7 14.5H4z" />
        <path class="wave" d="M15 9.2a4 4 0 0 1 0 5.6" />
        <path class="wave" d="M17.8 6.6a7.6 7.6 0 0 1 0 10.8" />
      </svg>
    </button>
  </div>
  <!-- Phones: a brown paper square with two white bars opens the menu full screen (like ensemblelapalatine.com) -->
  <button type="button" class="n-burger" aria-label="Menu" aria-expanded="false" aria-controls="n-menu">
    <span class="n-burger__bar"></span><span class="n-burger__bar"></span>
  </button>
  <nav class="n-nav" id="n-menu" aria-label="Main">
    <a href="/next/#work">Work</a>
    <a href="/next/about/">About</a>
    <a href="/next/#contact">Contact</a>
    <button type="button" class="n-icon n-theme" aria-label="Switch to dark mode">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
      </svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" />
      </svg>
    </button>
  </nav>
</header>

<script>
  // Say my name
  const say = document.querySelector<HTMLButtonElement>('.n-say');
  let audio: HTMLAudioElement | null = null;
  say?.addEventListener('click', () => {
    audio ??= new Audio(say.dataset.audio);
    audio.currentTime = 0;
    say.classList.add('is-playing');
    audio.onended = () => say.classList.remove('is-playing');
    audio.play().catch(() => say.classList.remove('is-playing'));
  });

  // Phone menu: full-screen panel; closes on Escape, on a link, or on the button again
  const burger = document.querySelector<HTMLButtonElement>('.n-burger');
  const setMenu = (open: boolean) => {
    document.documentElement.classList.toggle('is-menu-open', open);
    burger?.setAttribute('aria-expanded', String(open));
    burger?.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
  };
  burger?.addEventListener('click', () => setMenu(burger.getAttribute('aria-expanded') !== 'true'));
  document.querySelectorAll('#n-menu a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') { setMenu(false); burger.focus(); } });
  window.matchMedia('(min-width: 701px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  // Light / dark: remembered for next time
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.n-theme');
  const label = () => toggle?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  label();
  toggle?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('ze-theme', root.dataset.theme); } catch {}
    label();
  });
</script>
