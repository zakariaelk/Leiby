---
// Header: wordmark (bends on hover), "say my name" speaker, nav, light/dark switch.
// Each letter gets its offset on an arc: the first name bends up, the last name bends down.
const ARC = 7;      // px at the middle of the word
const TILT = 16;    // degrees at the ends
const letters = (word: string, dir: 1 | -1) => {
  const chars = [...word];
  const mid = (chars.length - 1) / 2;
  return chars.map((ch, i) => {
    const t = mid ? (i - mid) / mid : 0; // -1 … 1 across the word
    const y = (-dir * ARC * (1 - t * t)).toFixed(2);
    const r = (dir * TILT * t).toFixed(2);
    return { ch, style: `--y:${y}px;--r:${r}deg;--d:${i}` };
  });
};
const first = letters('Zakaria', 1);
const last = letters('El Khachia', -1);
---
<header class="n-head">
  <div class="n-brand">
    <a href="/next/" class="n-name" aria-label="Zakaria El Khachia, home">
      <span class="n-name__line" aria-hidden="true">{first.map((l) => <span class="n-name__l" style={l.style}>{l.ch}</span>)}</span>
      <span class="n-name__line" aria-hidden="true">{last.map((l) => <span class="n-name__l" style={l.style}>{l.ch}</span>)}</span>
    </a>
    <button type="button" class="n-icon n-say" aria-label="Hear how to say Zakaria El Khachia" data-audio="/audio/zakaria-el-khachia.m4a">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 9.5h3l4.5-4v13L7 14.5H4z" />
        <path class="wave" d="M15 9.2a4 4 0 0 1 0 5.6" />
        <path class="wave" d="M17.8 6.6a7.6 7.6 0 0 1 0 10.8" />
      </svg>
    </button>
  </div>
  <nav class="n-nav" aria-label="Main">
    <a href="/next/#work">Work</a>
    <a href="/next/about/">About</a>
    <a href="/next/#contact">Contact</a>
    <button type="button" class="n-icon n-theme" aria-label="Switch to dark mode">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
      </svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" />
      </svg>
    </button>
  </nav>
</header>

<script>
  // Say my name
  const say = document.querySelector<HTMLButtonElement>('.n-say');
  let audio: HTMLAudioElement | null = null;
  say?.addEventListener('click', () => {
    audio ??= new Audio(say.dataset.audio);
    audio.currentTime = 0;
    say.classList.add('is-playing');
    audio.onended = () => say.classList.remove('is-playing');
    audio.play().catch(() => say.classList.remove('is-playing'));
  });

  // Light / dark: remembered for next time
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.n-theme');
  const label = () => toggle?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  label();
  toggle?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('ze-theme', root.dataset.theme); } catch {}
    label();
  });
</script>
