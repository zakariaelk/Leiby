---
// Next design direction: home. Shared by /next/ (dark torn-paper button) and /next/marker/
// (marker-highlight link), so the two CTA styles can be compared side by side.
import { Image, getImage } from 'astro:assets';
import Next from '../../layouts/Next.astro';
import { getProjects } from '../../lib/data';
import { posterFor } from '../../lib/media';

interface Props { cta?: 'drawn' | 'marker' }
const { cta = 'drawn' } = Astro.props;

const FEATURED = ['mitigating-risk-with-location-based-alerts', '3e-international', 'ngosafety-website-redesign'];
const projects = await getProjects();
const featured = await Promise.all(FEATURED.map(async (id) => {
  const p = projects.find((x) => x.id === id)!;
  const video = p.data.featuredVideo;
  const poster = video ? posterFor(video) : undefined;
  const posterSrc = poster ? (await getImage({ src: poster, format: 'webp', width: 1280 })).src : undefined;
  return { p, video, poster, posterSrc };
}));
const rest = projects.filter((p) => !FEATURED.includes(p.id));

// Torn paper. Each edge is two masked layers: the paper itself, and just above it a lighter,
// half-transparent rim of fibres (what a real tear shows). Both outlines come from a seeded
// random walk (same on every build), roughened with an SVG displacement filter.
const rng = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const walk = (seed: number, lift = 0) => {
  const r = rng(seed);
  let x = 0, d = `M0 48 L0 ${(30 + r() * 8 - lift).toFixed(1)}`;
  while (x < 1000) {
    x = Math.min(1000, x + 10 + r() * 30);
    const peak = r() < 0.16 ? 6 + r() * 10 : 24 + r() * 16;
    d += ` L${x.toFixed(1)} ${(peak - lift - r() * lift).toFixed(1)}`;
  }
  return d + ' L1000 48 Z';
};
const tearMask = (d: string, seed: number, rough: number, freq: string) => {
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 48' preserveAspectRatio='none'><filter id='t' x='-2%' y='-60%' width='104%' height='220%'><feTurbulence type='fractalNoise' baseFrequency='${freq}' numOctaves='2' seed='${seed}'/><feDisplacementMap in='SourceGraphic' scale='${rough}' xChannelSelector='R' yChannelSelector='G'/></filter><path filter='url(#t)' d='${d}'/></svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
};
const tear = (seed: number) =>
  `--tear-main:${tearMask(walk(seed), seed, 3, '.5 .9')};--tear-rim:${tearMask(walk(seed, 3), seed + 1, 7, '.9 1.6')}`;

// Hand-drawn outline for the "Read the case" button: two quick, uneven passes around the box
const sketch = (seed: number) => {
  const r = rng(seed);
  const j = (n: number) => (r() - 0.5) * n;
  const pass = () => {
    const c = [[2 + j(3), 3 + j(4)], [198 + j(3), 2 + j(4)], [197 + j(3), 54 + j(4)], [3 + j(3), 53 + j(4)]];
    let d = `M${c[0][0].toFixed(1)} ${c[0][1].toFixed(1)}`;
    for (let i = 1; i <= 4; i++) {
      const [x0, y0] = c[i - 1], [x1, y1] = c[i % 4];
      d += ` Q${((x0 + x1) / 2 + j(4)).toFixed(1)} ${((y0 + y1) / 2 + j(5)).toFixed(1)} ${(x1 + j(2)).toFixed(1)} ${(y1 + j(2)).toFixed(1)}`;
    }
    return d;
  };
  return `${pass()} ${pass()}`;
};
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<Next>
  <section class="n-intro n-wrap">
    <h1>Product designer, creative builder.</h1>
    <p>12+ years designing and building web and mobile interfaces. <br />Most recently at <a href="https://ngosafety.org" target="_blank" rel="noopener">INSO</a>, I designed and shipped safety tools for humanitarian workers in conflict zones.</p>
  </section>

  <section class="n-featured" id="work" aria-labelledby="featured-title">
    <h2 class="n-label n-featured__label n-wrap" id="featured-title">Featured work</h2>
    {featured.map(({ p, video, poster, posterSrc }, i) => (
      <div class:list={['n-band', i % 2 ? 'n-band--beige' : 'n-band--light']}>
        <div class="n-tear n-tear--top" style={tear(7 + i * 13)} aria-hidden="true"><span class="n-tear__rim"></span><span class="n-tear__paper"></span></div>
        <article class="n-card n-wrap">
          <p class="n-card__client"><strong>{p.data.org ?? p.data.client}</strong>{p.data.projectName && <span> – {p.data.projectName}</span>}</p>
          <h3 class="n-card__title"><a href={`/work/${p.id}/`}>{p.data.statement ?? p.data.headline}</a></h3>
          <div class="n-card__visual">
            {video ? (
              <video class="n-video" src={video} poster={posterSrc} width={poster?.width} height={poster?.height} muted loop playsinline preload="none" aria-label={`${p.data.org ?? p.data.client}: ${p.data.projectName ?? ''}`}></video>
            ) : (
              <Image src={p.data.cover} alt={`${p.data.org ?? p.data.client}: ${p.data.projectName ?? p.data.title}`} widths={[640, 960, 1280, 1600]} sizes="(min-width: 900px) 52vw, 100vw" />
            )}
          </div>
          <dl class="n-card__meta">
            {p.data.sector && <div><dt>Industry</dt><dd>{p.data.sector}</dd></div>}
            {p.data.role && <div><dt>Role</dt><dd>{p.data.role}</dd></div>}
          </dl>
          <a class:list={['n-cta', `n-cta--${cta}`]} href={`/work/${p.id}/`}>
            {cta === 'drawn' && <svg class="n-cta__outline" viewBox="0 0 200 56" preserveAspectRatio="none" aria-hidden="true"><path d={sketch(3 + i * 11)} /></svg>}
            <span>Read the case</span><span class="sr-only">: {p.data.projectName ?? p.data.title}</span><Fragment set:html={arrow} />
          </a>
        </article>
        {i === featured.length - 1 && (
          <div class="n-tear n-tear--bottom" style={tear(91)} aria-hidden="true"><span class="n-tear__rim"></span><span class="n-tear__paper"></span></div>
        )}
      </div>
    ))}
  </section>

  <section class="n-list n-wrap" aria-labelledby="more-label">
    <p class="n-label" id="more-label">Selected work</p>
    <ul>
      {rest.map((p) => (
        <li>
          <a href={`/work/${p.id}/`}>
            <span class="n-list__name">{p.data.client}</span>
            <span class="n-list__desc">{p.data.intro}</span>
            <span class="n-list__year">{p.data.year}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Next>

<script>
  // Videos play only while on screen, and never with reduced motion
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.n-video')];
  if (reduce) videos.forEach((v) => { v.controls = true; v.preload = 'metadata'; });
  else {
    const io = new IntersectionObserver((entries) => entries.forEach(({ target, isIntersecting }) => {
      const v = target as HTMLVideoElement;
      if (isIntersecting) v.play().catch(() => {}); else v.pause();
    }), { threshold: 0.3 });
    videos.forEach((v) => io.observe(v));
  }
</script>
