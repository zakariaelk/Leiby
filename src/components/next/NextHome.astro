---
// Next design direction: home. Shared by /next/ (brown paper-card button), /next/marker/
// (marker-highlight link) and /next/white/ (white and gray paper, dark-gray cut-outs).
import { Image, getImage } from 'astro:assets';
import Next from '../../layouts/Next.astro';
import { getProjects } from '../../lib/data';
import { posterFor } from '../../lib/media';
import { blob, brushFrame, cutEdge, unevenRect } from '../../lib/papercut';
import NextLogo from './NextLogo.astro';
import NextLogoWord from './NextLogoWord.astro';

interface Props { cta?: 'paper' | 'marker'; palette?: 'paper' | 'mono' }
const { cta = 'paper', palette = 'paper' } = Astro.props;

const FEATURED = ['mitigating-risk-with-location-based-alerts', '3e-international', 'ngosafety-website-redesign'];
const projects = await getProjects();
const featured = await Promise.all(FEATURED.map(async (id) => {
  const p = projects.find((x) => x.id === id)!;
  const video = p.data.featuredVideo;
  const poster = video ? posterFor(video) : undefined;
  const posterSrc = poster ? (await getImage({ src: poster, format: 'webp', width: 1280 })).src : undefined;
  return { p, video, poster, posterSrc };
}));
const rest = projects.filter((p) => !FEATURED.includes(p.id));

// Paper-cut band edge: the band's own paper (colour + texture), masked by a gently uneven cut
const cut = (seed: number) => {
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 24' preserveAspectRatio='none'><path d='${cutEdge(seed)}'/></svg>`;
  return `--cut:url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
};
const inso = '/work/mitigating-risk-with-location-based-alerts/';
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<Next palette={palette}>
  <section class="n-intro n-wrap">
    <h1>Product designer, <br class="n-intro__br" /><span class="n-intro__second">creative builder.</span></h1>
    <p>12+ years designing and building web and mobile interfaces. <br />Most recently at <a href="https://ngosafety.org" target="_blank" rel="noopener">INSO</a>, I designed and shipped safety tools for humanitarian workers in conflict zones.</p>
  </section>

  <section class="n-featured" id="work" aria-labelledby="featured-title">
    <h2 class="n-label n-featured__label n-wrap" id="featured-title">Featured work</h2>
    {featured.map(({ p, video, poster, posterSrc }, i) => (
      <div class:list={['n-band', i % 2 ? 'n-band--beige' : 'n-band--light']}>
        <div class="n-cut n-cut--top" style={cut(7 + i * 13)} aria-hidden="true"></div>
        <article class="n-card n-wrap">
          <p class="n-card__client"><strong>{p.data.org ?? p.data.client}</strong></p>
          <h3 class="n-card__title"><a href={`/work/${p.id}/`}>{p.data.statement ?? p.data.headline}</a></h3>
          <div class="n-card__visual">
            <!-- painted brown frame behind the visual; only its outer edge shows (La Palatine) -->
            <svg class="n-brush" viewBox="-20 -20 1040 640" preserveAspectRatio="none" aria-hidden="true"><path d={brushFrame(7 + i * 5)} /></svg>
            {video ? (
              <video class="n-video" src={video} poster={posterSrc} width={poster?.width} height={poster?.height} muted loop playsinline preload="none" aria-label={`${p.data.org ?? p.data.client}: ${p.data.projectName ?? ''}`}></video>
            ) : (
              <Image src={p.data.cover} alt={`${p.data.org ?? p.data.client}: ${p.data.projectName ?? p.data.title}`} widths={[640, 960, 1280, 1600]} sizes="(min-width: 900px) 52vw, 100vw" />
            )}
          </div>
          <div class="n-card__foot">
            <dl class="n-card__meta">
              {p.data.sector && <div class="n-card__meta-item"><dt>Industry</dt><dd>{p.data.sector}</dd></div>}
              {p.data.role && <div class="n-card__meta-item n-card__meta-item--mid"><dt>Role</dt><dd>{p.data.role}</dd></div>}
            </dl>
            {cta === 'paper' ? (
              <a class:list={['n-cta', 'n-cta--paper']} href={`/work/${p.id}/`} aria-label={`Read the case: ${p.data.projectName ?? p.data.title}`}>
                <span aria-hidden="true">Read the case</span><Fragment set:html={arrow} />
              </a>
            ) : (
              <a class:list={['n-cta', `n-cta--${cta}`]} href={`/work/${p.id}/`}>
                <span>Read the case</span><span class="sr-only">: {p.data.projectName ?? p.data.title}</span><Fragment set:html={arrow} />
              </a>
            )}
          </div>
        </article>
        {i === featured.length - 1 && (
          <div class="n-cut n-cut--bottom" style={cut(91)} aria-hidden="true"></div>
        )}
      </div>
    ))}
  </section>

  <section class="n-list n-wrap" aria-labelledby="more-label">
    <p class="n-label" id="more-label">Selected work</p>
    <ul>
      {rest.map((p) => (
        <li>
          <a href={`/work/${p.id}/`}>
            <span class="n-list__name">{p.data.client}</span>
            <span class="n-list__desc">{p.data.intro}</span>
            <span class="n-list__year">{p.data.year}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Trials, to judge in context before they move into the header and the case studies -->
  <section class="n-trials n-wrap" aria-label="Design trials">
    <p class="n-label">Trial · button styles</p>
    <div class="n-trials__buttons">
      <figure>
        <a class="n-btn n-btn--tape" href={inso}><span>Read the case</span><span class="sr-only">: Alert mobile app</span><Fragment set:html={arrow} /></a>
        <figcaption>A · Masking tape: tilted, straightens and lifts on hover</figcaption>
      </figure>
      <figure>
        <a class="n-btn n-btn--loop" href={inso}>
          <span>Read the case</span><span class="sr-only">: Alert mobile app</span><Fragment set:html={arrow} />
          <svg class="n-btn__under" viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true"><path d="M3 6C40 3 85 8 130 5S185 4 197 6" /></svg>
          <svg class="n-btn__loop" viewBox="0 0 240 80" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M30 18C80 2 190 4 226 26C246 40 228 66 170 72C110 78 30 74 14 52C2 34 30 14 74 9" /></svg>
        </a>
        <figcaption>B · Marker loop: drawn around the words on hover</figcaption>
      </figure>
      <figure>
        <a class="n-btn n-btn--circle" href={inso}>
          <span>Read the case</span><span class="sr-only">: Alert mobile app</span>
          <svg class="n-btn__dot" viewBox="0 0 100 100" aria-hidden="true"><path class="n-btn__dot-shape" d={blob(41, 50, 50, 46)} /><path class="n-btn__dot-arrow" d="M29 50h40M55 36l14 14-14 14" /></svg>
        </a>
        <figcaption>C · Paper circle: turns and nudges on hover, like the logo</figcaption>
      </figure>
    </div>
    <p class="n-label">Trial · logo</p>
    <div class="n-trials__logos">
      <figure><NextLogo variant="black" seed={11} /><figcaption>Brown + black</figcaption></figure>
      <figure><NextLogo variant="blue" seed={23} /><figcaption>Brown + pastel blue</figcaption></figure>
    </div>
    <p class="n-label">Trial · logo with the full first name (collapses after 5s, opens on hover)</p>
    <div class="n-trials__logos n-trials__logos--word">
      <figure><NextLogoWord variant="black" /><figcaption>Brown + black</figcaption></figure>
      <figure><NextLogoWord variant="blue" /><figcaption>Brown + pastel blue</figcaption></figure>
      <figure><NextLogoWord variant="vermilion" /><figcaption>Brown + vermilion</figcaption></figure>
      <figure><NextLogoWord variant="sage" /><figcaption>Brown + sage</figcaption></figure>
      <figure><NextLogoWord variant="ochre" /><figcaption>Brown + ochre</figcaption></figure>
      <figure><NextLogoWord variant="pink" /><figcaption>Brown + dusty pink</figcaption></figure>
    </div>
    <p class="n-label">Trial · paper-cut frames</p>
    <div class="n-trials__frames">
      {featured.map(({ p }, i) => (
        <figure class="n-frame" style={`clip-path:${unevenRect(31 + i * 7, 1.4)}`}>
          <Image src={p.data.cover} alt={`${p.data.org ?? p.data.client}: ${p.data.projectName ?? p.data.title}`} widths={[480, 800]} sizes="(min-width: 900px) 30vw, 100vw" style={`clip-path:${unevenRect(57 + i * 5, 0.9)}`} />
        </figure>
      ))}
    </div>
  </section>
</Next>

<script>
  // Videos play only while on screen, and never with reduced motion
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.n-video')];
  if (reduce) videos.forEach((v) => { v.controls = true; v.preload = 'metadata'; });
  else {
    const io = new IntersectionObserver((entries) => entries.forEach(({ target, isIntersecting }) => {
      const v = target as HTMLVideoElement;
      if (isIntersecting) v.play().catch(() => {}); else v.pause();
    }), { threshold: 0.3 });
    videos.forEach((v) => io.observe(v));
  }

  // Logo trial: full first name for 5 seconds, then collapse to Z / ز (hover opens it again)
  const words = document.querySelectorAll<HTMLElement>('[data-lw]');
  if (reduce) words.forEach((w) => w.classList.add('is-collapsed'));
  else window.setTimeout(() => words.forEach((w) => w.classList.add('is-collapsed')), 5000);

  // Logo trial: the two paper circles drift apart with the pointer (-1…1 across the window)
  if (!reduce) {
    let frame = 0;
    window.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        document.documentElement.style.setProperty('--mx', ((e.clientX / innerWidth) * 2 - 1).toFixed(3));
        document.documentElement.style.setProperty('--my', ((e.clientY / innerHeight) * 2 - 1).toFixed(3));
      });
    }, { passive: true });
  }
</script>
