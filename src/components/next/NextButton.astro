---
// "Read the case": the words, then a round paper cut-out holding the arrow. On hover (or focus)
// the paper turns 15° every quarter second, in jerky stop-motion steps, for as long as the
// pointer stays; the arrow stays still.
import { blob } from '../../lib/papercut';

interface Props { href: string; name?: string; seed?: number }
const { href, name, seed = 41 } = Astro.props;
---
<a class="n-btn" href={href}>
  <span class="n-btn__label">Read the case</span>{name && <span class="sr-only">: {name}</span>}
  <svg class="n-btn__dot" viewBox="0 0 100 100" aria-hidden="true">
    <g class="n-btn__dot-turn"><path class="n-btn__dot-shape" d={blob(seed, 50, 50, 46)} /></g>
    <path class="n-btn__dot-arrow" d="M29 50h40M55 36l14 14-14 14" />
  </svg>
</a>
