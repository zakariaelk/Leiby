---
// "Read the case" (or another label): the words, then a round paper cut-out holding the arrow. On
// hover (or focus) the paper turns 15° every quarter second, in jerky stop-motion steps, for as
// long as the pointer stays; the arrow stays still. external: opens in a new tab, arrow ↗.
import { blob } from '../../lib/papercut';

interface Props { href: string; label?: string; name?: string; seed?: number; external?: boolean }
const { href, label = 'Read the case', name, seed = 41, external = false } = Astro.props;
---
<a class="n-btn" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
  <span class="n-btn__label">{label}</span>{name && <span class="sr-only">: {name}</span>}{external && <span class="sr-only"> (opens in a new tab)</span>}
  <svg class="n-btn__dot" viewBox="0 0 100 100" aria-hidden="true">
    <g class="n-btn__dot-turn"><path class="n-btn__dot-shape" d={blob(seed, 50, 50, 46)} /></g>
    <path class="n-btn__dot-arrow" d="M29 50h40M55 36l14 14-14 14" transform={external ? 'rotate(-45 50 50)' : undefined} />
  </svg>
</a>
