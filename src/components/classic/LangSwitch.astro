---
// Language switcher for the home hero. Two looks:
// - button (/v2/): black button with a soft triangle, pinned top right; on hover it lifts off
//   a gray copy of itself (the "detached" effect from the yellow version)
// - link (site root): a text link like "My work" / "Email me" with the same triangle
// The site is English only for now: picking a language updates the label and the checked
// item, the translations come later.
interface Props { look?: 'button' | 'link' }
const { look = 'button' } = Astro.props;
const languages = [
  { code: 'en', label: 'English' },
  { code: 'fr', label: 'Français' },
  { code: 'ar', label: 'العربية' },
  { code: 'nl', label: 'Nederlands' },
  { code: 'zh-Hans', label: '中文' },
];
---
<div class={`ze-lang ze-lang--${look}`}>
  <button type="button" class="ze-lang__btn" aria-haspopup="menu" aria-expanded="false" aria-controls="ze-lang-menu">
    <span class="sr-only">Language: </span><span class="ze-lang__current">English</span>
    <svg class="ze-lang__tri" viewBox="0 0 12 8" aria-hidden="true"><path d="M2 1.5h8L6 6.5z" /></svg>
  </button>
  <ul class="ze-lang__menu" id="ze-lang-menu" role="menu" hidden>
    {languages.map((l, i) => (
      <li role="none">
        <button type="button" role="menuitemradio" aria-checked={i === 0 ? 'true' : 'false'} lang={l.code} data-label={l.label} tabindex="-1">
          {l.label}
        </button>
      </li>
    ))}
  </ul>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.ze-lang');
  if (root) {
    const btn = root.querySelector<HTMLButtonElement>('.ze-lang__btn')!;
    const menu = root.querySelector<HTMLUListElement>('.ze-lang__menu')!;
    const current = root.querySelector<HTMLElement>('.ze-lang__current')!;
    const items = [...menu.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]')];

    const open = () => {
      menu.hidden = false;
      void menu.offsetWidth; // start the fade from the closed state
      root.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      (items.find((i) => i.getAttribute('aria-checked') === 'true') ?? items[0]).focus();
    };
    const close = (focusBtn = false) => {
      root.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
      if (focusBtn) btn.focus();
    };

    btn.addEventListener('click', () => (menu.hidden ? open() : close()));
    items.forEach((item, i) => {
      item.addEventListener('click', () => {
        items.forEach((it) => it.setAttribute('aria-checked', String(it === item)));
        current.textContent = item.dataset.label!;
        close(true);
      });
      item.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
        if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
        if (e.key === 'Tab') close();
      });
    });
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) close(true); });
    document.addEventListener('click', (e) => { if (!menu.hidden && !root.contains(e.target as Node)) close(); });
  }
</script>

<style is:global>
  .ze-hero { position: relative; }
  .ze-lang { position: relative; z-index: 5; }
  .ze-lang--button { position: absolute; top: 40px; right: 0; }
  @media (max-width: 991px) { .ze-lang--button { top: 36px; } }
  @media (max-width: 700px) { .ze-lang--button { top: 32px; } }

  .ze-lang--button .ze-lang__btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 9px 14px 9px 16px;
    border: 0; border-radius: 6px;
    background: #101010; color: #fff;
    font: 500 15px/1.2 'Outfit Variable', 'Outfit', sans-serif;
    cursor: pointer;
    box-shadow: 0 0 0 0 #d4d4d4;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ze-lang--button .ze-lang__btn:hover,
  .ze-lang--button.is-open .ze-lang__btn { transform: translate(-3px, -3px); box-shadow: 3px 3px 0 0 #d4d4d4; }
  .ze-lang--button .ze-lang__btn:active { transform: translate(0, 0); box-shadow: 0 0 0 0 #d4d4d4; }
  .ze-lang__btn:focus-visible { outline: 2px solid #101010; outline-offset: 3px; }

  .ze-lang__tri { width: 11px; height: 8px; transition: transform 0.2s ease; }
  .ze-lang__tri path { fill: currentColor; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
  .ze-lang.is-open .ze-lang__tri { transform: rotate(180deg); }

  .ze-lang__menu {
    position: absolute; top: calc(100% + 10px); right: 0;
    min-width: 168px; margin: 0; padding: 6px; list-style: none;
    background: #fff; border: 1px solid #ececec; border-radius: 6px;
    box-shadow: 0 10px 30px -12px rgba(16, 16, 16, 0.25);
    opacity: 0; transform: translateY(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .ze-lang__menu[hidden] { display: none; }
  .ze-lang.is-open .ze-lang__menu { opacity: 1; transform: none; }
  .ze-lang__menu button {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    width: 100%; padding: 9px 10px; border: 0; border-radius: 4px; background: none;
    font: 400 15px/1.2 'Outfit Variable', 'Outfit', sans-serif; color: #101010; text-align: start;
    cursor: pointer;
  }
  .ze-lang__menu button[lang='ar'] { font-family: 'Outfit Variable', 'Geeza Pro', 'Noto Sans Arabic', sans-serif; }
  .ze-lang__menu button:hover,
  .ze-lang__menu button:focus-visible { background: #f5f5f5; outline: none; }
  .ze-lang__menu button[aria-checked='true'] { font-weight: 500; }
  .ze-lang__menu button[aria-checked='true']::after {
    content: ''; width: 6px; height: 6px; border-radius: 50%; background: #101010; flex: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ze-lang__btn, .ze-lang__tri, .ze-lang__menu { transition: none; }
  }
</style>
