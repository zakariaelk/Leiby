---
// zakariaelk.com home page, ported from the WordPress theme (index.php).
// Changes from the original: the portrait is small and sits above the name, and the top
// right of the hero holds either the cities, written vertically (Casablanca → Beijing →
// Rotterdam, the site root), or a language button (the /v2/ version).
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Classic from '../../layouts/Classic.astro';
import HeroEye from './HeroEye.astro';
import LangSwitch from './LangSwitch.astro';
import home from '../../content/pages/home.json';
import settings from '../../content/pages/settings.json';
import { getProjects } from '../../lib/data';

interface Props { aside?: 'cities' | 'lang'; noindex?: boolean }
const { aside = 'cities', noindex = false } = Astro.props;

const projects = await getProjects();
const featured = projects.find((p) => p.data.featured) ?? projects[0];
const rows = projects.filter((p) => p !== featured);
const about = await getEntry('about', 'index');
const experience = about?.data.experience ?? [];
const education = about?.data.education ?? [];

// Intro from the CMS: *phrase* gets the marker highlight, **word** is bold
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const intro = esc(home.heroText)
  .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  .replace(/\*(.+?)\*/g, '<span class="crayon-underline">$1</span>');
---
<Classic bodyId="home" noindex={noindex}>
  <div class="boxed ze-home">
    <section class:list={['ze-hero', aside === 'cities' && 'ze-hero--aside']}>
      <div class="ze-hero-left">
        <div class="ze-face-mini"><HeroEye /></div>
        <h1 class="sr-only">{settings.name}, product designer</h1>
        <a href="/" class="ze-name" aria-hidden="true">{settings.name}</a>
        <div class="ze-intro-text"><p set:html={intro} /></div>
        <div class="ze-intro-links">
          <a href="#work-list">My work</a>
          <a href="#" class="ze-email-reveal" data-email={settings.email}>Email me</a>
        </div>
      </div>
      {aside === 'cities' ? (
        <div class="ze-hero-aside">
          <LangSwitch look="link" />
          <ol class="ze-cities" aria-label="Cities I have lived in">
            {home.cities.map((city, i) => (
              <>
                {i > 0 && <li class="ze-cities__dots" aria-hidden="true"></li>}
                <li class="ze-cities__city">
                  <span class="ze-cities__name">{city}</span>
                  {home.cityYears?.[i] && <span class="ze-cities__year">{home.cityYears[i]}</span>}
                </li>
              </>
            ))}
          </ol>
        </div>
      ) : (
        <LangSwitch />
      )}
    </section>

    <a href={`/work/${featured.id}/`} class="ze-featured">
      <div class="ze-featured-text">
        <div class="ze-featured-eyebrow">Featured work</div>
        <h2 class="ze-featured-title">{featured.data.headline}</h2>
        <p class="ze-featured-desc">{featured.data.intro}</p>
        <span class="ze-featured-cta">Read the case</span>
      </div>
      <div class="ze-featured-visual">
        {featured.data.featuredVideo ? (
          <video src={featured.data.featuredVideo} autoplay muted loop playsinline preload="metadata" aria-label={featured.data.title}></video>
        ) : (
          <Image src={featured.data.cover} alt={featured.data.title} widths={[640, 1024, 1400]} sizes="(min-width: 992px) 60vw, 100vw" />
        )}
      </div>
    </a>

    <div class="ze-section-label" id="work-list">Selected work</div>
    <div class="ze-tbl ze-work-tbl">
      {rows.map((p) => (
        <a class="ze-row ze-row--link" href={`/work/${p.id}/`}>
          {p.data.previews.length > 0 && (
            <span class="ze-preview" aria-hidden="true">
              <Image src={p.data.previews[0]} alt="" widths={[640, 960]} sizes="560px" loading="lazy" />
              {p.data.previews[1] && <Image class="ze-preview-alt" src={p.data.previews[1]} alt="" widths={[640, 960]} sizes="560px" loading="lazy" />}
            </span>
          )}
          <span class="ze-row-name">{p.data.client}</span>
          <span class="ze-row-desc">{p.data.intro}</span>
          <span class="ze-row-meta">{p.data.year}</span>
        </a>
      ))}
    </div>

    <div class="ze-section-label">Experience</div>
    <div class="ze-tbl">
      {experience.map((e) => (
        <div class="ze-row"><span class="ze-row-name">{e.name}</span><span class="ze-row-desc">{e.role}</span><span class="ze-row-meta">{e.years.replace('-', '–')}</span></div>
      ))}
    </div>

    <div class="ze-section-label">Education</div>
    <div class="ze-tbl">
      {education.map((e) => (
        <div class="ze-row"><span class="ze-row-name">{e.name}</span><span class="ze-row-desc">{e.role}</span><span class="ze-row-meta">{e.years}</span></div>
      ))}
    </div>
  </div>
</Classic>

<script>
  // "Email me" turns into the address (as before)
  const reveal = document.querySelector<HTMLAnchorElement>('.ze-email-reveal');
  reveal?.addEventListener('click', (e) => {
    e.preventDefault();
    const email = reveal.dataset.email!;
    reveal.textContent = email;
    reveal.href = `mailto:${email}`;
    reveal.classList.add('revealed');
  }, { once: true });

  // Marker highlight under "product designer", drawn once the loader is gone
  const underline = document.querySelector('.ze-intro-text .crayon-underline');
  if (underline) {
    const draw = () => window.setTimeout(() => underline.classList.add('is-drawn'), 400);
    const root = document.documentElement;
    if (!root.classList.contains('ze-loading')) draw();
    else {
      const mo = new MutationObserver(() => {
        if (!root.classList.contains('ze-loading')) { mo.disconnect(); draw(); }
      });
      mo.observe(root, { attributes: true, attributeFilter: ['class'] });
    }
  }
</script>

<style is:global>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Small portrait above the name, mirrored so it looks into the page */
  .ze-face-mini { margin-bottom: 14px; transform: scaleX(-1); transform-origin: center; width: max-content; }
  .ze-face-mini .ze-hero-eye { height: 75px !important; width: auto !important; }
  @media (max-width: 700px) { .ze-face-mini .ze-hero-eye { height: 64px !important; } }

  /* Golden-ratio grid (desktop and tablet):
     - across: the text column takes 61.8% of the width, the right column the other 38.2%
     - down: the portrait block (face + space under it) is 38.2% of the hero's content height,
       so the name sits on the golden line and the intro + links fill the other 61.8%
     The right column mirrors it: language switcher level with the top of the portrait,
     cities running the full height to the links' baseline. */
  .ze-hero { align-items: flex-end; }
  .ze-hero--aside .ze-hero-left { flex: 0 0 61.8%; max-width: 61.8%; }
  .ze-hero--aside .ze-face-mini { margin-bottom: 30px; }
  .ze-hero-aside {
    align-self: stretch; flex: none;
    display: flex; gap: 28px;
  }
  .ze-hero-aside .ze-lang { align-self: flex-start; }
  .ze-hero-aside .ze-cities { align-self: flex-end; }

  /* Cities, written vertically, read bottom to top; the year sits under each name */
  .ze-cities {
    list-style: none; margin: 0; padding: 0;
    display: flex; align-items: flex-start; gap: 8px; margin-bottom: 4px;
    writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: 'Outfit Variable', 'Outfit', sans-serif; font-size: 14px; line-height: 1.25; letter-spacing: 0.06em;
    color: #101010; white-space: nowrap;
  }
  .ze-cities__city { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
  .ze-cities__name { font-weight: 500; }
  .ze-cities__year { font-weight: 100; font-size: 13px; letter-spacing: 0.08em; }
  /* dotted line, centred on the city names' line */
  .ze-cities__dots { width: 0; height: 12px; border-left: 2px dotted #9a9a9a; margin-block-start: calc(0.625em - 1px); }
  @media (max-width: 700px) {
    .ze-hero--aside .ze-hero-left { flex: none; max-width: 100%; }
    .ze-hero--aside .ze-face-mini { margin-bottom: 14px; }
    .ze-hero-aside { display: contents; }
    .ze-hero-aside .ze-lang { position: absolute; top: 32px; right: 0; }
    .ze-hero-aside .ze-cities { align-self: flex-start; }
    .ze-cities { writing-mode: horizontal-tb; transform: none; margin-top: 4px; gap: 10px; }
    .ze-cities__dots { height: 0; width: 16px; border-left: 0; border-top: 2px dotted #9a9a9a; margin-block-start: calc(0.625em - 1px); }
  }

  /* The featured card's clip is now a video (was a GIF): same box as the image */
  .ze-featured-visual video { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
