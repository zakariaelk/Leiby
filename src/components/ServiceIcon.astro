---
// Small playful shape compositions, one per service.
interface Props { icon: string; color?: string }
const { icon, color = 'coral' } = Astro.props;
---
<svg class:list={['sicon', `c-${color}`]} viewBox="0 0 64 48" aria-hidden="true">
  {icon === 'target' && (
    <g>
      <circle cx="30" cy="24" r="20" fill="var(--ink)" />
      <circle cx="30" cy="24" r="12" fill="var(--accent)" class="sicon__spin" />
      <circle cx="30" cy="24" r="5" fill="var(--white)" />
      <path d="M44 6 58 20" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" />
    </g>
  )}
  {icon === 'browser' && (
    <g>
      <rect x="6" y="6" width="44" height="34" rx="5" fill="var(--ink)" />
      <rect x="11" y="15" width="34" height="20" rx="2" fill="var(--white)" />
      <circle cx="12" cy="10.5" r="2" fill="var(--sun)" />
      <rect x="14" y="19" width="14" height="12" rx="2" fill="var(--accent)" class="sicon__bob" />
      <circle cx="52" cy="38" r="8" fill="var(--accent)" />
    </g>
  )}
  {icon === 'phone' && (
    <g>
      <rect x="20" y="2" width="24" height="44" rx="6" fill="var(--ink)" />
      <rect x="24" y="8" width="16" height="30" rx="2" fill="var(--white)" />
      <circle cx="32" cy="18" r="5" fill="var(--accent)" class="sicon__bob" />
      <path d="M6 30a8 8 0 0 1 16 0Z" fill="var(--accent)" />
      <path d="M48 12l8 0M48 20l12 0" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" />
    </g>
  )}
  {icon === 'chart' && (
    <g>
      <rect x="8" y="26" width="10" height="18" rx="2" fill="var(--ink)" />
      <rect x="22" y="14" width="10" height="30" rx="2" fill="var(--accent)" class="sicon__grow" />
      <rect x="36" y="20" width="10" height="24" rx="2" fill="var(--ink)" />
      <circle cx="54" cy="10" r="7" fill="var(--accent)" />
    </g>
  )}
  {icon === 'blocks' && (
    <g>
      <rect x="6" y="22" width="20" height="20" rx="4" fill="var(--ink)" />
      <rect x="30" y="22" width="20" height="20" rx="10" fill="var(--accent)" />
      <rect x="18" y="0" width="20" height="20" rx="4" fill="var(--accent)" class="sicon__bob" transform="rotate(12 28 10)" />
      <path d="M54 8l6 6-6 6-6-6Z" fill="var(--ink)" />
    </g>
  )}
  {icon === 'spark' && (
    <g>
      <circle cx="26" cy="26" r="16" fill="none" stroke="var(--ink)" stroke-width="5" />
      <path d="M38 38 48 46" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
      <path d="M52 2l3 8 8 3-8 3-3 8-3-8-8-3 8-3Z" fill="var(--accent)" class="sicon__spin" />
      <circle cx="26" cy="26" r="6" fill="var(--accent)" />
    </g>
  )}
</svg>

<style>
  .sicon { width: 56px; height: auto; flex: none; overflow: visible; }
  .sicon__spin, .sicon__bob, .sicon__grow { transform-box: fill-box; transform-origin: center; transition: transform 0.6s var(--ease-bounce); }
  .sicon__grow { transform-origin: bottom; }
  :global(a:hover) .sicon__spin, :global(a:focus-visible) .sicon__spin { transform: rotate(90deg) scale(1.15); }
  :global(a:hover) .sicon__bob, :global(a:focus-visible) .sicon__bob { transform: translateY(-4px) rotate(-10deg); }
  :global(a:hover) .sicon__grow, :global(a:focus-visible) .sicon__grow { transform: scaleY(1.25); }
</style>
