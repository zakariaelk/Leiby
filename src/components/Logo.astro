---
// Monogram (ز, the Arabic Z) + name in Latin and Arabic.
import settings from '../content/pages/settings.json';

interface Props { size?: 'md' | 'lg' }
const { size = 'md' } = Astro.props;
---
<span class:list={['logo', `logo--${size}`]}>
  <span class="logo__mark" aria-hidden="true"><span class="arabic">ز</span></span>
  <span class="logo__type">
    <span class="logo__name">{settings.name}</span>
    <span class="logo__ar arabic" lang="ar" dir="rtl">{settings.nameArabic}</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--text); }
  .logo__mark {
    width: 2.6rem; height: 2.6rem; border-radius: 50%; flex: none;
    display: grid; place-items: center;
    background: var(--pink); color: var(--on-accent);
    font-size: 1.5rem; line-height: 1;
    transition: transform 0.5s var(--ease-bounce), background 0.3s;
  }
  .logo__mark span { transform: translateY(-0.1em); }
  :global(a:hover) > .logo .logo__mark { transform: rotate(-12deg) scale(1.06); background: var(--sky); }
  .logo__type { display: grid; line-height: 1; gap: 0.3rem; }
  .logo__name { font-size: 1.12rem; font-weight: var(--fw-bold); letter-spacing: -0.03em; white-space: nowrap; }
  .logo__ar { font-size: 1.1rem; color: var(--pink); justify-self: start; line-height: 1.1; }

  .logo--lg .logo__mark { width: 4rem; height: 4rem; font-size: 2.3rem; }
  .logo--lg .logo__name { font-size: 1.6rem; }
  .logo--lg .logo__ar { font-size: 1.3rem; }
</style>
