---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Wave from './Wave.astro';
import HeroPortrait from './HeroPortrait.astro';
import Monument from './Monument.astro';
import ProjectCard from './ProjectCard.astro';
import GetInTouch from './GetInTouch.astro';
import BridgeLine from './BridgeLine.astro';
import Walker from './Walker.astro';
import { themeFor } from '../lib/variant';
import home from '../content/pages/home.json';
import { getProjects, inlineMarkup } from '../lib/data';

interface Props { art?: 'line' | 'cartoon'; noindex?: boolean }
const { art = 'line', noindex = false } = Astro.props;
const { theme, base } = themeFor(Astro.url.pathname);

const projects = await getProjects();
const spotlight = projects.find((p) => p.data.featured) ?? projects[0];
const rest = projects.filter((p) => p !== spotlight);
const about = await getEntry('about', 'index');
const timeline = [
  { title: 'Experience', rows: about?.data.experience ?? [] },
  { title: 'Education', rows: about?.data.education ?? [] },
];
---
<Base noindex={noindex}>
  <!-- ========== Intro ========== -->
  <section class="hero bg-sun">
    <div class="glow hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__art">
        {theme === 'bridge' ? <BridgeLine /> : theme === 'mono' ? <HeroPortrait variant="cartoon" look="moods" /> : <HeroPortrait variant={art} />}
      </div>
      <div class="hero__text">
        <p class="hero__intro" set:html={inlineMarkup(home.heroText)} />
        <div class="hero__actions">
          <a href="#work" class="btn">My work <span class="arrow arrow--down" aria-hidden="true">→</span></a>
          <GetInTouch variant="ghost" />
        </div>
        {theme === 'bridge' ? <Walker cities={home.cities} /> : (
          <ol role="list" class="cities" aria-label="Cities I've lived and worked in">
            {home.cities.map((city, i) => (
              <li style={`--i:${i}`}><Monument city={city} size={34} />{city}</li>
            ))}
          </ol>
        )}
      </div>
    </div>
  </section>
  <Wave bg="var(--sun)" />

  <!-- ========== Work ========== -->
  <section id="work" class="work" aria-labelledby="work-title">
    <div class="container">
      <h2 id="work-title" class="eyebrow">{home.workTitle}</h2>

      <a href={`${base}/projects/${spotlight.id}/`} class="spotlight">
        <div class="spotlight__media">
          <Image src={spotlight.data.cover} alt="" widths={[640, 1024, 1440]} sizes="(min-width: 1000px) 60vw, 100vw" />
        </div>
        <div class="spotlight__text">
          <p class="spotlight__label">Featured · {spotlight.data.client}</p>
          <h3 class="spotlight__title">{spotlight.data.title}</h3>
          <p class="muted">{spotlight.data.summary}</p>
          <span class="arrow-link spotlight__cta">Read the case <span class="arrow" aria-hidden="true">→</span></span>
        </div>
      </a>

      <div class="work__grid">
        {rest.map((p, i) => <ProjectCard project={p} delay={(i % 2) * 0.08} />)}
      </div>
    </div>
  </section>

  <!-- ========== Experience & education ========== -->
  <section class="section cv" aria-label="Experience and education">
    <div class="container cv__grid">
      {timeline.map((group) => (
        <div class="cv__group" data-reveal>
          <h2 class="eyebrow">{group.title}</h2>
          <ol role="list">
            {group.rows.map((row) => (
              <li class="cv__row">
                <span class="cv__name">{row.name}</span>
                <span class="cv__role">{row.role}</span>
                <span class="cv__years">{row.years}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
      <a href={`${base}/about/`} class="arrow-link cv__more">More about me <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; padding-block: calc(var(--header-h) + clamp(1.5rem, 4vw, 3.5rem)) clamp(2rem, 4vw, 3rem); overflow: hidden; }
  .hero__glow { right: -20vw; top: -25vw; }
  .hero__grid { position: relative; display: grid; gap: 2rem 4rem; align-items: center; }
  .hero__art { width: 100%; max-width: min(280px, 76vw); justify-self: center; margin-top: 1.5rem; }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 1.15fr 1fr; }
    /* Text on the left, portrait on the right so he looks towards the text */
    .hero__art { order: 2; max-width: 520px; margin-top: 0; }
  }
  .hero__intro {
    font-size: var(--fs-intro); line-height: 1.28; font-weight: var(--fw-medium); letter-spacing: -0.025em;
    max-width: 30ch; animation: rise 0.9s var(--ease-out) 0.1s both;
  }
  .hero__intro :global(mark) {
    color: inherit; background: var(--white); padding: 0 0.2em; margin: 0 -0.05em;
    border-radius: 0.2em; box-decoration-break: clone; -webkit-box-decoration-break: clone;
    box-shadow: 3px 3px 0 var(--coral);
  }
  .hero__intro :global(strong) { font-weight: var(--fw-bold); }
  /* Black & white versions: a yellow marker stroke instead of the white label */
  :global([data-theme='mono']) .hero__intro :global(mark),
  :global([data-theme='bridge']) .hero__intro :global(mark) {
    background: linear-gradient(transparent 58%, #ffc442 58%, #ffc442 92%, transparent 92%);
    box-shadow: none; border-radius: 0;
  }
  :global([data-theme='mono']) .cities { font-size: 0.95rem; color: var(--ink-soft); }
  :global([data-theme='mono']) .cities :global(.monument) { width: 24px; height: 24px; opacity: 0.6; }
  :global([data-theme='mono']) .cities li + li::before { background: repeating-linear-gradient(90deg, var(--line) 0 3px, transparent 3px 8px); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; animation: rise 0.9s var(--ease-out) 0.25s both; }

  .cities { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 0; margin-top: 2.25rem; font-weight: var(--fw-medium); }
  .cities li { display: inline-flex; align-items: center; gap: 0.5rem; animation: rise 0.7s var(--ease-out) both; animation-delay: calc(0.4s + var(--i) * 0.12s); }
  .cities li + li::before {
    content: ''; width: clamp(1rem, 3vw, 2.25rem); height: 2px; margin-inline: 0.7rem;
    background: repeating-linear-gradient(90deg, var(--ink) 0 3px, transparent 3px 8px);
  }
  .cities :global(.monument) { transition: transform 0.4s var(--ease-bounce); }
  .cities li:hover :global(.monument) { transform: translateY(-4px) rotate(-4deg); }
  /* Phones: three columns, monument above the name, no connectors */
  @media (max-width: 480px) {
    .cities { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; font-size: 0.92rem; }
    .cities li { flex-direction: column; gap: 0.35rem; text-align: center; }
    .cities li + li::before { display: none; }
  }

  /* ---------- Work ---------- */
  .work { padding-block: clamp(2rem, 4vw, 3rem) var(--space-section); }
  .spotlight {
    display: grid; overflow: hidden; border-radius: var(--radius-lg); background: var(--white);
    text-decoration: none; margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    box-shadow: 0 0 0 0 var(--ink);
    transition: box-shadow 0.4s var(--ease-out), transform 0.4s var(--ease-bounce);
  }
  .spotlight:hover { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 0 var(--coral); }
  @media (min-width: 1000px) { .spotlight { grid-template-columns: 1.5fr 1fr; } }
  .spotlight__media { overflow: hidden; background: var(--coral); aspect-ratio: 16 / 10; }
  .spotlight__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .spotlight__text { padding: clamp(1.5rem, 3vw, 3rem); display: grid; gap: 0.9rem; align-content: center; }
  @media (min-width: 1000px) { .spotlight__text { order: -1; } }
  .spotlight__label { font-size: var(--fs-small); font-weight: var(--fw-bold); letter-spacing: 0.1em; text-transform: uppercase; color: var(--coral-ink); }
  .spotlight__title { font-size: var(--fs-h2); letter-spacing: -0.04em; }
  .spotlight__cta { justify-self: start; margin-top: 0.5rem; }

  .work__grid { display: grid; gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  @media (min-width: 700px) { .work__grid { grid-template-columns: repeat(2, 1fr); } }

  /* ---------- CV ---------- */
  .cv { padding-top: 0; }
  .cv__grid { display: grid; gap: 3rem; }
  .cv__row {
    display: grid; gap: 0.25rem 2rem; padding-block: 1.1rem; border-top: 1px solid var(--line);
    grid-template-columns: 1fr auto;
    grid-template-areas: 'name years' 'role role';
  }
  .cv__row:last-child { border-bottom: 1px solid var(--line); }
  .cv__name { grid-area: name; font-weight: var(--fw-bold); }
  .cv__role { grid-area: role; color: var(--ink-soft); }
  .cv__years { grid-area: years; color: var(--ink-soft); font-variant-numeric: tabular-nums; white-space: nowrap; }
  @media (min-width: 800px) {
    .cv__row { grid-template-columns: 200px 1fr auto; grid-template-areas: 'name role years'; align-items: baseline; }
  }
  .cv__more { justify-self: start; }
</style>
