---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/data';

interface Props { post: CollectionEntry<'posts'>; delay?: number }
const { post, delay = 0 } = Astro.props;
const { title, date, tag, color, summary } = post.data;
---
<a href={`/blog/${post.id}/`} class:list={['postcard', `c-${color}`]} data-reveal style={`--delay:${delay}s`}>
  <div class="postcard__art" aria-hidden="true">
    <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice">
      <rect width="320" height="180" fill="var(--accent)" />
      <circle class="pa-1" cx="250" cy="60" r="44" fill="var(--sun)" />
      <path class="pa-2" d="M40 180a70 70 0 0 1 140 0Z" fill="var(--ink)" />
      <rect class="pa-3" x="190" y="110" width="40" height="40" rx="8" fill="var(--white)" />
    </svg>
  </div>
  <p class="postcard__tag">{tag}</p>
  <h3 class="postcard__title">{title} <span class="arrow" aria-hidden="true">→</span></h3>
  <p class="postcard__summary">{summary}</p>
  <time class="postcard__date" datetime={date.toISOString()}>{formatDate(date)}</time>
</a>

<style>
  .postcard { display: grid; gap: 0.6rem; text-decoration: none; align-content: start; }
  .postcard__art { border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 9; margin-bottom: 0.4rem; }
  .postcard__art svg { width: 100%; height: 100%; }
  .postcard__art :global(*) { transform-box: fill-box; transform-origin: center; transition: transform 0.6s var(--ease-bounce); }
  .postcard:hover .pa-1 { transform: translate(-30px, 10px) scale(1.15); }
  .postcard:hover .pa-2 { transform: rotate(-10deg); }
  .postcard:hover .pa-3 { transform: rotate(45deg); }
  .postcard__tag { font-size: var(--fs-small); font-weight: var(--fw-bold); color: var(--coral); }
  .postcard__title { font-size: var(--fs-h3); letter-spacing: -0.025em; }
  .postcard__summary { color: var(--ink-soft); }
  .postcard__date { font-size: var(--fs-small); font-weight: var(--fw-medium); color: var(--coral); }
</style>
