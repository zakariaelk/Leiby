---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Journey from './Journey.astro';
import RecordPlayer from './RecordPlayer.astro';
import home from '../content/pages/home.json';
import { themeFor } from '../lib/variant';

const { theme } = themeFor(Astro.url.pathname);

const about = await getEntry('about', 'index');
if (!about) throw new Error('About page content is missing');
const { Content } = await render(about);
const { title, intro, experience, education, languages } = about.data;
// Retro and UX open the About page with the record player from the sketch
const music = theme === 'retro' || theme === 'ux';
const groups = [
  { title: 'Experience', rows: experience },
  { title: 'Education', rows: education },
];
---
<Base title="About" description={intro}>
  {music ? (
    <section class="music-hero">
      <div class="container music-hero__grid">
        <div>
          <p class="eyebrow">About</p>
          <h1 class="music-hero__title">Outside work and personal duties, I enjoy making and experimenting with music, sounds and instruments.</h1>
          <p class="lead music-hero__intro">{intro}</p>
        </div>
        <RecordPlayer />
      </div>
    </section>
  ) : (
    <PageHero eyebrow="About" title={title} intro={intro}>
      {theme === 'simple' ? <p class="about-cities">{home.cities.join(' → ')}</p> : <div slot="art"><Journey cities={home.cities} /></div>}
    </PageHero>
  )}

  <section class="section">
    <div class="container about__grid">
      <article class="prose" data-reveal><Content /></article>
      <aside class="cv" data-reveal style="--delay:.1s">
        {groups.map((g) => (
          <div>
            <h2 class="eyebrow">{g.title}</h2>
            <ol role="list">
              {g.rows.map((e) => (
                <li>
                  <div class="cv__top"><strong>{e.name}</strong><span>{e.years}</span></div>
                  <p>{e.role}</p>
                </li>
              ))}
            </ol>
          </div>
        ))}
        {languages.length > 0 && (
          <div>
            <h2 class="eyebrow">Languages</h2>
            <ul role="list" class="langs">
              {languages.map((l) => <li>{l}</li>)}
            </ul>
          </div>
        )}
        <a href="#contact" class="btn">Work with me <span class="arrow" aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>
</Base>

<style>
  .music-hero { padding: calc(var(--header-h) + clamp(2rem, 5vw, 4rem)) 0 clamp(2.5rem, 5vw, 4rem); background: var(--paper); }
  .music-hero__grid { display: grid; gap: 2.5rem 4rem; align-items: center; }
  @media (min-width: 960px) { .music-hero__grid { grid-template-columns: 1fr 1fr; } }
  .music-hero__title { font-size: clamp(1.9rem, 1.3rem + 2.2vw, 3.2rem); line-height: 1.1; max-width: 18ch; }
  .music-hero__intro { margin-top: 1.25rem; max-width: 42ch; color: var(--ink-soft); }
  :global([data-theme='retro']) .music-hero { background-image: radial-gradient(rgba(43, 29, 20, 0.2) 1.2px, transparent 1.4px); background-size: 22px 22px; }
  .about-cities { margin-top: 1.25rem; color: var(--ink-soft); font-weight: var(--fw-medium); }
  .section { padding-top: clamp(2rem, 4vw, 3.5rem); }
  .about__grid { display: grid; gap: 3rem; }
  @media (min-width: 1024px) { .about__grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(3rem, 6vw, 6rem); align-items: start; } }
  .cv { background: var(--white); border-radius: var(--radius-lg); padding: clamp(1.5rem, 3vw, 2.25rem); display: grid; gap: 2rem; justify-items: start; }
  .cv > div { width: 100%; }
  .cv .eyebrow { margin-bottom: 1rem; }
  @media (min-width: 1024px) { .cv { position: sticky; top: calc(var(--header-h) + 2rem); } }
  .cv ol { display: grid; gap: 1.1rem; }
  .cv ol li { border-top: 1px solid var(--line); padding-top: 0.75rem; }
  .cv__top { display: flex; justify-content: space-between; gap: 1rem; font-size: 1.05rem; }
  .cv__top span { color: var(--ink-soft); font-weight: var(--fw-medium); font-size: var(--fs-small); white-space: nowrap; }
  .cv p { color: var(--ink-soft); margin-top: 0.25rem; font-size: 0.97rem; }
  .langs { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .langs li { padding: 0.35rem 0.85rem; border-radius: 999px; background: var(--sun); font-weight: var(--fw-medium); font-size: 0.95rem; }
</style>
