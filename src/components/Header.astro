---
import Logo from './Logo.astro';
import GetInTouch from './GetInTouch.astro';

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => href.startsWith('/') && !href.includes('#') && path.startsWith(href);
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Zakaria El Khachia, home">
      <Logo />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul role="list">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <GetInTouch class="site-nav__cta" />
    </nav>

    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="container mobile-menu__inner">
      <ul role="list">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label} <span class="arrow" aria-hidden="true">→</span></a></li>
        ))}
      </ul>
      <GetInTouch variant="light" class="mobile-menu__cta" />
      <svg class="mobile-menu__shape" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="146" cy="66" r="54" fill="var(--coral)" />
        <circle cx="140" cy="60" r="54" fill="var(--sun)" />
      </svg>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a:not([data-git])').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }
</script>

<style>
  /* Transparent over the hero (the hero slides up underneath it), yellow once the page scrolls */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    margin-bottom: calc(-1 * var(--header-h));
    background: rgba(255, 196, 66, 0);
    transition: background 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  :global(.is-scrolled) .site-header { background: rgba(255, 196, 66, 0.97); box-shadow: 0 1px 0 var(--line); }
  .site-header__inner {
    height: var(--header-h);
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .site-header__logo { text-decoration: none; position: relative; z-index: 2; }

  .site-nav { display: none; align-items: center; gap: clamp(1.25rem, 2.5vw, 2.5rem); }
  .site-nav ul { display: flex; gap: clamp(1.25rem, 2.5vw, 2.25rem); }
  .site-nav ul a { font-weight: var(--fw-medium); text-decoration: none; position: relative; padding-block: 0.4rem; }
  .site-nav ul a::after {
    content: ''; position: absolute; left: 50%; bottom: -2px; width: 7px; height: 7px;
    border-radius: 50%; background: var(--coral);
    transform: translateX(-50%) scale(0); transition: transform 0.35s var(--ease-bounce);
  }
  .site-nav ul a:hover::after, .site-nav ul a[aria-current='page']::after { transform: translateX(-50%) scale(1); }
  .site-nav__cta { min-height: 44px; padding-inline: 1.15rem; }

  .menu-toggle {
    position: relative; z-index: 2;
    width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--ink);
  }
  .menu-toggle__bars { display: grid; gap: 5px; width: 20px; }
  .menu-toggle__bars span { height: 2px; background: var(--white); border-radius: 2px; transition: transform 0.35s var(--ease-out), opacity 0.2s; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: 0; z-index: 1;
    background: var(--ink); color: var(--white);
    padding-top: var(--header-h);
    overflow-y: auto;
    animation: menu-in 0.45s var(--ease-out);
  }
  .mobile-menu[hidden] { display: none; }
  :global(.menu-open) .site-header__logo :global(.logo) { color: var(--white); }
  :global(.menu-open) .site-header__logo :global(.logo__role) { color: rgba(255, 255, 255, 0.7); }
  :global(.menu-open) .site-header__logo :global(.logo__face) { background: var(--sun); color: var(--ink); }
  :global(.menu-open) { overflow: hidden; }
  .mobile-menu__inner { display: grid; gap: 2rem; padding-block: 2rem 3rem; position: relative; min-height: calc(100dvh - var(--header-h)); align-content: start; }
  .mobile-menu ul { display: grid; gap: 0.25rem; }
  .mobile-menu :global(.mobile-menu__cta) { justify-self: start; }
  .mobile-menu li { animation: item-in 0.5s var(--ease-out) both; animation-delay: calc(var(--i) * 60ms + 80ms); }
  .mobile-menu ul a {
    display: flex; align-items: center; justify-content: space-between;
    font-size: clamp(2.25rem, 9vw, 3.5rem); font-weight: var(--fw-bold); letter-spacing: -0.04em;
    text-decoration: none; padding-block: 0.35rem; border-bottom: 2px solid rgba(255, 255, 255, 0.15);
  }
  .mobile-menu__shape { position: absolute; right: var(--gutter); bottom: 2rem; width: min(40vw, 180px); pointer-events: none; }

  @keyframes menu-in { from { clip-path: circle(0% at calc(100% - 3rem) 2.5rem); } to { clip-path: circle(150% at calc(100% - 3rem) 2.5rem); } }
  @keyframes item-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  @media (min-width: 900px) {
    .site-nav { display: flex; }
    .menu-toggle, .mobile-menu { display: none; }
  }
</style>
